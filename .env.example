# =================== 数据库配置（必需） ===================
# PostgreSQL 数据库连接配置
# 本地开发：localhost
# Docker 容器：tgnl-postgres（容器名称）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tgnl_db
DB_USER=tgnl_user
DB_PASSWORD=tgnl_password

# =================== Redis 配置（可选） ===================
# Redis 连接配置（用于缓存，如果未配置则使用内存缓存）
# 本地开发：localhost
# Docker 容器：tgnl-redis（容器名称）
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# =================== Next.js 配置 ===================
# Next.js 环境（development/production）
# 开发环境：development
# 生产环境：production
NODE_ENV=production

# Next.js 端口（默认 3000）
PORT=3000

# =================== 能量池系统配置 ===================
# 能量池系统 API 地址（用于内部调用，如刷新上游信息）
# 本地开发：http://localhost:3000
# Docker 容器内：http://tgnl-home-web:3000
# 服务器部署：https://your-domain.com
ENERGY_POOL_API_URL=http://localhost:3000

# 公共 API 地址（用于脚本调用，可选）
# 如果未设置，将使用 ENERGY_POOL_API_URL
# NEXT_PUBLIC_API_URL=http://localhost:3000

# =================== 机器人通知配置 ===================
# 默认机器人通知地址（如果数据库中没有配置 bot_notify_url 时使用）
# 格式：http://host:port/api/recharge-notify
# 本地开发：http://localhost:8080/api/recharge-notify
# Docker 容器内：http://tgnl-admin-bot:8080/api/recharge-notify
# 服务器部署：https://your-bot-domain.com/api/recharge-notify
BOT_NOTIFY_URL=http://localhost:8080/api/recharge-notify

# 机器人通知地址映射（可选）
# 格式1（JSON）：{"api_username1": "http://bot1:8080/api/recharge-notify", "api_username2": "http://bot2:8080/api/recharge-notify"}
# 格式2（键值对）：api_user1:http://bot1:8080/api/recharge-notify,api_user2:http://bot2:8080/api/recharge-notify
# BOT_NOTIFY_URL_MAP={"api_c110325c": "http://localhost:8080/api/recharge-notify"}

# =================== 上游服务配置 ===================
# 上游服务基础地址（如果数据库中没有配置 provider_base_url 时使用）
# 默认：https://zhangpu.online
ZP_BASE_URL=https://zhangpu.online

# =================== 支付检测任务配置 ===================
# 支付检测间隔（毫秒），默认 10000（10秒）
# 建议范围：5000-30000（5秒-30秒）
CHECK_INTERVAL=10000

# 管理器检查间隔（毫秒），默认 10000（10秒）
# 建议范围：5000-30000（5秒-30秒）
MANAGER_INTERVAL=10000

# =================== Tron API 配置 ===================
# Tron API Key（用于查询交易状态）
# 默认使用公共 API Key，生产环境建议使用自己的 API Key
# 获取方式：访问 https://www.trongrid.io/ 注册账号获取 API Key
TRON_API_KEY=93ed8c29-bd1c-4940-ad6c-7eb53bf58bcb

# =================== 认证配置 ===================
# 登录路径（默认：/admin/auth/login）
# 可以修改为其他路径以增强安全性
LOGIN_PATH=/admin/auth/login

# 公共登录路径（用于前端，可选）
# 如果未设置，将使用 LOGIN_PATH
# NEXT_PUBLIC_LOGIN_PATH=/admin/auth/login

# 认证密钥（用于生成和验证 token，生产环境必须修改为随机字符串）
# 生成方式：openssl rand -base64 32
# 或：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=your-random-secret-key-change-in-production

# =================== 访问控制配置（安全） ===================
# 是否只允许通过域名访问登录页面（true/false）
# 开启后，只能通过域名+端口+后缀访问登录页面，增强安全性
# 本地开发建议设为 false，生产环境建议设为 true
REQUIRE_DOMAIN_FOR_LOGIN=false

# 允许的域名列表（多个域名用逗号分隔）
# 例如：example.com,www.example.com,admin.example.com
# 如果 REQUIRE_DOMAIN_FOR_LOGIN=true，则只允许列表中的域名访问
# 如果不设置，则允许所有域名（不推荐生产环境）
# ALLOWED_DOMAINS=example.com,www.example.com

# =================== HTTPS 配置（可选） ===================
# 是否启用 HTTPS（生产环境建议启用）
# 如果设置为 true，Cookie 将使用 Secure 标志
# ENABLE_HTTPS=false

# =================== Docker 部署说明 ===================
# 如果使用 Docker 部署，请注意：
# 1. DB_HOST 应设置为容器名称：tgnl-postgres
# 2. REDIS_HOST 应设置为容器名称：tgnl-redis
# 3. ENERGY_POOL_API_URL 在容器内应使用：http://tgnl-home-web:3000
# 4. BOT_NOTIFY_URL 在容器内应使用：http://tgnl-admin-bot:8080/api/recharge-notify
# 5. docker-compose.yml 中的环境变量会覆盖 .env.local 中的值

# =================== 使用说明 ===================
# 1. 将此文件复制为 .env.local 并填入实际值
# 2. .env.local 文件不会被提交到版本控制（已在 .gitignore 中）
# 3. 生产环境必须修改以下配置：
#    - AUTH_SECRET（必须改为随机字符串）
#    - DB_PASSWORD（使用强密码）
#    - REQUIRE_DOMAIN_FOR_LOGIN（建议设为 true）
#    - ALLOWED_DOMAINS（建议设置允许的域名）
# 4. 数据库密码等敏感信息请妥善保管，不要泄露
