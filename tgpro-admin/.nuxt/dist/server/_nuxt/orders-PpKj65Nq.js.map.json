,iBAAa,IAAA,mBAAA,gBACrB,eAAA;;yCAEM,MAAA,MAAK,CAAC,iBAAa,IAAA,mBAAA,gBAAA,UAAA,CAAA,CAAA,IAAA,eAC5B,KAAK,IAAI,MAAA,MAAK,CAAC,cAAa,CAAA,CAAA,gKAAA;;IAM5B,MAAK;IAA8B,OAAM;;sPASJ,aAAa,MAAA,MAAK,CAAC,cAAa,CAAA,CAAA,0CAAA;;IAEnE,MAAK;IAAoB,OAAM;;;;IAKjC,MAAK;IAAoB,OAAM;;oPASM,MAAA,MAAK,CAAC,eAAc,CAAA,2CAAA;;IAEvD,MAAK;IAA2B,OAAM;;;;IAKxC,MAAK;IAAwB,OAAM;;;;gBAa/B,MAAA,YAAW;wEAAA,QAAA,SAAA;IACpB,aAAY;IACZ,OAAM;IACN,MAAK;;;gBAGI,MAAA,aAAY;0EAAA,QAAA,SAAA;IACpB,SAAS;IACV,OAAM;;;iBAoBY,MAAA,eAAc,GAAvB,UAAK;gIAEmC,MAAM,YAAW,CAAA,oMAAA,eAKZ,MAAM,KAAK,KAAK,OAAM,EAAA,CAAA,CAAA,gEAAA,eAGvB,MAAM,KAAK,KAAI,CAAA,4CAAA,eACvB,MAAM,KAAK,MAAK,CAAA,+EAAA,eAKxB,MAAM,QAAO,CAAA,gDAAA,eACL,MAAM,SAAQ,CAAA,gFAAA,eAGT,aAAa,MAAM,OAAM,CAAA,CAAA,mCAAA;;KAItE,OAAO,eAAe,MAAM,OAAM;KACnC,SAAQ;KACR,MAAK;;uBAGE,GAAA,SAAA,WAAA,aAAA;6CADJ,eAAe,MAAM,OAAM,CAAA,GAAA;mDAA3B,eAAe,MAAM,OAAM,CAAA,EAAA,EAAA,CAAA;;;;8EAGc,WAAW,MAAM,UAAS,CAAA,CAAA,qDAAA;;KAG7D,SAAQ;KAAQ,MAAK;KAAM,UAAK,WAAE,UAAU,MAAA;;uBAE3C,GAAA,SAAA,WAAA,aAAA;;OADD,MAAK;OAAkB,OAAM;;mBAApC,YAAgD,kBAAA;OAAzC,MAAK;OAAkB,OAAM;;;;;QAG9B,MAAM,WAAM,eAAoB,MAAM,WAAM,SAAA,OAAA,mBAAA,oBAAA;KAClD,SAAQ;KACR,MAAK;KACL,OAAM;KACL,UAAK,WAAE,WAAW,MAAK;KACxB,OAAM;;uBAGE,GAAA,SAAA,WAAA,aAAA;;OADD,MAAK;OAAyB,OAAM;;mBAA3C,YAAuD,kBAAA;OAAhD,MAAK;OAAyB,OAAM;;;;;;QAGrC,MAAM,WAAM,UAAA,OAAA,mBAAA,oBAAA;KAClB,SAAQ;KACR,MAAK;KACL,OAAM;KACL,UAAK,WAAE,aAAa,MAAA;;uBAGb,GAAA,SAAA,WAAA,aAAA;;OADD,MAAK;OAAoB,OAAM;;mBAAtC,YAAkD,kBAAA;OAA3C,MAAK;OAAoB,OAAM;;;;;;;KAGtC,SAAQ;KACR,MAAK;KACL,OAAM;KACL,UAAK,WAAE,mBAAmB,MAAK;KAChC,OAAM;;uBAGE,GAAA,SAAA,WAAA,aAAA;;OADD,MAAK;OAAoB,OAAM;;mBAAtC,YAAkD,kBAAA;OAA3C,MAAK;OAAoB,OAAM;;;;;;;qLAYzC,MAAA,YAAW,GAAA,KAAQ,MAAA,SAAQ,GAAA,EAAA,CAAA,KAAA,eAAa,KAAK,IAAI,MAAA,YAAW,GAAG,MAAA,SAAQ,EAAE,MAAA,YAAW,CAAA,CAAA,CAAA,OAAA,eAAY,MAAA,YAAW,CAAA,CAAA,mCAAA;;IAIhH,SAAQ;IACR,MAAK;IACJ,UAAU,MAAA,YAAW,KAAA;IACrB,UAAK,WAAE,YAAA;;sBAGA,GAAA,SAAA,WAAA,aAAA;;kCAFT,QAED,CAAA;;;;;IAEE,SAAQ;IACR,MAAK;IACJ,UAAU,MAAA,YAAW,KAAK,MAAA,WAAU;IACpC,UAAK,WAAE,YAAA;;sBAGA,GAAA,SAAA,WAAA,aAAA;;kCAFT,QAED,CAAA","names":[],"sources":["../../../../pages/orders/index.vue","../../../../pages/orders/index.vue"],"sourcesContent":["<template>\n  <div class=\"space-y-6\">\n    <!-- 页面标题 -->\n    <div class=\"flex items-center justify-between\">\n      <div>\n        <h1 class=\"text-2xl font-bold text-white flex items-center gap-3\">\n          <div class=\"w-8 h-8 bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg flex items-center justify-center\">\n            <UIcon name=\"i-heroicons-shopping-bag\" class=\"w-5 h-5 text-[#00dc82]\" />\n          </div>\n          订单管理\n        </h1>\n        <p class=\"mt-1 text-sm text-[#9ca3af]\">管理所有订单信息和交易记录</p>\n      </div>\n      <div class=\"flex gap-2\">\n        <USelect\n          v-model=\"selectedTimeRange\"\n          :options=\"timeRangeOptions\"\n          class=\"w-32\"\n        />\n        <UButton variant=\"outline\" size=\"sm\" @click=\"refreshOrders\">\n          <UIcon name=\"i-heroicons-arrow-path\" class=\"w-4 h-4 mr-2\" />\n          刷新\n        </UButton>\n        <UButton color=\"primary\" size=\"sm\" class=\"bg-[#00dc82] hover:bg-[#00dc82]/80\">\n          <UIcon name=\"i-heroicons-arrow-down-tray\" class=\"w-4 h-4 mr-2\" />\n          导出订单\n        </UButton>\n      </div>\n    </div>\n\n    <!-- 订单统计卡片 -->\n    <div class=\"grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4\">\n      <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg p-4\">\n        <div class=\"flex items-center justify-between\">\n          <div>\n            <p class=\"text-sm text-[#9ca3af]\">总订单数</p>\n            <p class=\"text-2xl font-bold text-white\">{{ formatNumber(stats.totalOrders) }}</p>\n            <div class=\"flex items-center mt-1\">\n              <UIcon \n                :name=\"stats.orderGrowth >= 0 ? 'i-heroicons-arrow-trending-up' : 'i-heroicons-arrow-trending-down'\" \n                :class=\"stats.orderGrowth >= 0 ? 'text-green-400' : 'text-red-400'\"\n                class=\"w-4 h-4 mr-1\"\n              />\n              <span :class=\"stats.orderGrowth >= 0 ? 'text-green-400' : 'text-red-400'\" class=\"text-sm\">\n                {{ Math.abs(stats.orderGrowth) }}%\n              </span>\n              <span class=\"text-[#9ca3af] text-sm ml-1\">vs 上期</span>\n            </div>\n          </div>\n          <div class=\"w-12 h-12 bg-blue-500/10 rounded-lg flex items-center justify-center\">\n            <UIcon name=\"i-heroicons-shopping-bag\" class=\"w-6 h-6 text-blue-400\" />\n          </div>\n        </div>\n      </div>\n\n      <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg p-4\">\n        <div class=\"flex items-center justify-between\">\n          <div>\n            <p class=\"text-sm text-[#9ca3af]\">总销售额</p>\n            <p class=\"text-2xl font-bold text-white\">¥{{ formatNumber(stats.totalRevenue) }}</p>\n            <div class=\"flex items-center mt-1\">\n              <UIcon \n                :name=\"stats.revenueGrowth >= 0 ? 'i-heroicons-arrow-trending-up' : 'i-heroicons-arrow-trending-down'\" \n                :class=\"stats.revenueGrowth >= 0 ? 'text-green-400' : 'text-red-400'\"\n                class=\"w-4 h-4 mr-1\"\n              />\n              <span :class=\"stats.revenueGrowth >= 0 ? 'text-green-400' : 'text-red-400'\" class=\"text-sm\">\n                {{ Math.abs(stats.revenueGrowth) }}%\n              </span>\n              <span class=\"text-[#9ca3af] text-sm ml-1\">vs 上期</span>\n            </div>\n          </div>\n          <div class=\"w-12 h-12 bg-green-500/10 rounded-lg flex items-center justify-center\">\n            <UIcon name=\"i-heroicons-currency-dollar\" class=\"w-6 h-6 text-green-400\" />\n          </div>\n        </div>\n      </div>\n\n      <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg p-4\">\n        <div class=\"flex items-center justify-between\">\n          <div>\n            <p class=\"text-sm text-[#9ca3af]\">待处理订单</p>\n            <p class=\"text-2xl font-bold text-white\">{{ formatNumber(stats.pendingOrders) }}</p>\n            <div class=\"flex items-center mt-1\">\n              <UIcon name=\"i-heroicons-clock\" class=\"w-4 h-4 mr-1 text-orange-400\" />\n              <span class=\"text-orange-400 text-sm\">需要处理</span>\n            </div>\n          </div>\n          <div class=\"w-12 h-12 bg-orange-500/10 rounded-lg flex items-center justify-center\">\n            <UIcon name=\"i-heroicons-clock\" class=\"w-6 h-6 text-orange-400\" />\n          </div>\n        </div>\n      </div>\n\n      <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg p-4\">\n        <div class=\"flex items-center justify-between\">\n          <div>\n            <p class=\"text-sm text-[#9ca3af]\">完成率</p>\n            <p class=\"text-2xl font-bold text-white\">{{ stats.completionRate }}%</p>\n            <div class=\"flex items-center mt-1\">\n              <UIcon name=\"i-heroicons-check-circle\" class=\"w-4 h-4 mr-1 text-green-400\" />\n              <span class=\"text-green-400 text-sm\">已完成</span>\n            </div>\n          </div>\n          <div class=\"w-12 h-12 bg-purple-500/10 rounded-lg flex items-center justify-center\">\n            <UIcon name=\"i-heroicons-chart-pie\" class=\"w-6 h-6 text-purple-400\" />\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 订单列表 -->\n    <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg\">\n      <div class=\"p-4 border-b border-[#2a2a2b]\">\n        <div class=\"flex items-center justify-between\">\n          <h2 class=\"text-lg font-semibold text-white\">订单列表</h2>\n          <div class=\"flex gap-2\">\n            <UInput\n              v-model=\"searchQuery\"\n              placeholder=\"搜索订单号、用户...\"\n              class=\"w-64\"\n              icon=\"i-heroicons-magnifying-glass\"\n            />\n            <USelect\n              v-model=\"statusFilter\"\n              :options=\"statusOptions\"\n              class=\"w-32\"\n            />\n          </div>\n        </div>\n      </div>\n\n      <div class=\"overflow-x-auto\">\n        <table class=\"w-full\">\n          <thead class=\"bg-[#0c0c0d]\">\n            <tr>\n              <th class=\"px-4 py-3 text-left text-xs font-medium text-[#9ca3af] uppercase tracking-wider\">订单号</th>\n              <th class=\"px-4 py-3 text-left text-xs font-medium text-[#9ca3af] uppercase tracking-wider\">用户</th>\n              <th class=\"px-4 py-3 text-left text-xs font-medium text-[#9ca3af] uppercase tracking-wider\">商品</th>\n              <th class=\"px-4 py-3 text-left text-xs font-medium text-[#9ca3af] uppercase tracking-wider\">金额</th>\n              <th class=\"px-4 py-3 text-left text-xs font-medium text-[#9ca3af] uppercase tracking-wider\">状态</th>\n              <th class=\"px-4 py-3 text-left text-xs font-medium text-[#9ca3af] uppercase tracking-wider\">创建时间</th>\n              <th class=\"px-4 py-3 text-left text-xs font-medium text-[#9ca3af] uppercase tracking-wider\">操作</th>\n            </tr>\n          </thead>\n          <tbody class=\"divide-y divide-[#2a2a2b]\">\n            <tr v-for=\"order in filteredOrders\" :key=\"order.id\" class=\"hover:bg-[#2a2a2b]/50\">\n              <td class=\"px-4 py-3\">\n                <div class=\"text-sm font-medium text-white\">{{ order.orderNumber }}</div>\n              </td>\n              <td class=\"px-4 py-3\">\n                <div class=\"flex items-center\">\n                  <div class=\"w-8 h-8 bg-[#2a2a2b] rounded-full flex items-center justify-center mr-3\">\n                    <span class=\"text-xs font-medium text-white\">{{ order.user.name.charAt(0) }}</span>\n                  </div>\n                  <div>\n                    <div class=\"text-sm font-medium text-white\">{{ order.user.name }}</div>\n                    <div class=\"text-sm text-[#9ca3af]\">{{ order.user.email }}</div>\n                  </div>\n                </div>\n              </td>\n              <td class=\"px-4 py-3\">\n                <div class=\"text-sm text-white\">{{ order.product }}</div>\n                <div class=\"text-sm text-[#9ca3af]\">数量: {{ order.quantity }}</div>\n              </td>\n              <td class=\"px-4 py-3\">\n                <div class=\"text-sm font-medium text-white\">¥{{ formatNumber(order.amount) }}</div>\n              </td>\n              <td class=\"px-4 py-3\">\n                <UBadge\n                  :color=\"getStatusColor(order.status) as any\"\n                  variant=\"subtle\"\n                  size=\"sm\"\n                >\n                  {{ getStatusLabel(order.status) }}\n                </UBadge>\n              </td>\n              <td class=\"px-4 py-3 text-sm text-[#9ca3af]\">{{ formatDate(order.createdAt) }}</td>\n              <td class=\"px-4 py-3\">\n                <div class=\"flex gap-2\">\n                  <UButton variant=\"ghost\" size=\"xs\" @click=\"viewOrder(order)\">\n                    <UIcon name=\"i-heroicons-eye\" class=\"w-4 h-4\" />\n                  </UButton>\n                  <UButton \n                    v-if=\"order.status === 'cancelled' || order.status === 'failed'\"\n                    variant=\"ghost\" \n                    size=\"xs\" \n                    color=\"blue\"\n                    @click=\"retryOrder(order)\"\n                    title=\"重新开通\"\n                  >\n                    <UIcon name=\"i-heroicons-arrow-path\" class=\"w-4 h-4\" />\n                  </UButton>\n                  <UButton \n                    v-if=\"order.status === 'pending'\"\n                    variant=\"ghost\" \n                    size=\"xs\" \n                    color=\"green\"\n                    @click=\"processOrder(order)\"\n                  >\n                    <UIcon name=\"i-heroicons-check\" class=\"w-4 h-4\" />\n                  </UButton>\n                  <UButton \n                    variant=\"ghost\" \n                    size=\"xs\" \n                    color=\"red\"\n                    @click=\"confirmDeleteOrder(order)\"\n                    title=\"删除订单\"\n                  >\n                    <UIcon name=\"i-heroicons-trash\" class=\"w-4 h-4\" />\n                  </UButton>\n                </div>\n              </td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <!-- 分页 -->\n      <div class=\"px-4 py-3 border-t border-[#2a2a2b] flex items-center justify-between\">\n        <div class=\"text-sm text-[#9ca3af]\">\n          显示 {{ (currentPage - 1) * pageSize + 1 }} 到 {{ Math.min(currentPage * pageSize, totalOrders) }} 条，共 {{ totalOrders }} 条\n        </div>\n        <div class=\"flex gap-2\">\n          <UButton \n            variant=\"outline\" \n            size=\"sm\" \n            :disabled=\"currentPage === 1\"\n            @click=\"currentPage--\"\n          >\n            上一页\n          </UButton>\n          <UButton \n            variant=\"outline\" \n            size=\"sm\" \n            :disabled=\"currentPage === totalPages\"\n            @click=\"currentPage++\"\n          >\n            下一页\n          </UButton>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\n// 页面元数据\ndefinePageMeta({\n  middleware: 'auth'\n})\n\n// 响应式数据\nconst searchQuery = ref('')\nconst statusFilter = ref('all')\nconst selectedTimeRange = ref('7d')\nconst currentPage = ref(1)\nconst pageSize = ref(10)\n\n// 时间范围选项\nconst timeRangeOptions = [\n  { label: '今天', value: '1d' },\n  { label: '7天', value: '7d' },\n  { label: '30天', value: '30d' },\n  { label: '90天', value: '90d' }\n]\n\n// 状态选项\nconst statusOptions = [\n  { label: '全部', value: 'all' },\n  { label: '待付款', value: 'pending' },\n  { label: '已付款', value: 'paid' },\n  { label: '处理中', value: 'processing' },\n  { label: '已发货', value: 'shipped' },\n  { label: '已完成', value: 'completed' },\n  { label: '已取消', value: 'cancelled' }\n]\n\n// 定义订单类型\ninterface Order {\n  id: string\n  orderNumber: string\n  user: {\n    name: string\n    email: string\n  }\n  product: string\n  quantity: number\n  amount: number\n  status: string\n  createdAt: string\n}\n\n// 响应式数据\nconst orders = ref<Order[]>([])\nconst loading = ref(false)\n\n// 统计数据\nconst stats = computed(() => {\n  const totalOrders = orders.value.length\n  const totalRevenue = orders.value.reduce((sum: number, order: Order) => sum + order.amount, 0)\n  const successOrders = orders.value.filter((order: Order) => order.status === 'completed').length\n  const failedOrders = orders.value.filter((order: Order) => order.status === 'cancelled').length\n  const completionRate = totalOrders > 0 ? ((successOrders / totalOrders) * 100).toFixed(1) : '0'\n  \n  return {\n    totalOrders,\n    totalRevenue,\n    pendingOrders: failedOrders,\n    completionRate: parseFloat(completionRate),\n    orderGrowth: 12.5, // 暂时保持静态值\n    revenueGrowth: 18.3 // 暂时保持静态值\n  }\n})\n\n// 获取订单数据\nconst fetchOrders = async () => {\n  loading.value = true\n  try {\n    const response = await $fetch('/api/orders') as any\n    if (response.success) {\n      orders.value = response.data.map((order: any) => ({\n        id: order.id,\n        orderNumber: `ORD-${order.id}`,\n        user: {\n          name: order.username,\n          email: `${order.username}@telegram.com`\n        },\n        product: getProductName(order.productType),\n        quantity: 1,\n        amount: order.amount,\n        status: mapOrderStatus(order.status),\n        createdAt: order.createdAt\n      }))\n    }\n  } catch (error) {\n    console.error('获取订单数据失败:', error)\n  } finally {\n    loading.value = false\n  }\n}\n\n// 页面加载时获取数据\nonMounted(() => {\n  fetchOrders()\n})\n\n// 计算属性\nconst filteredOrders = computed(() => {\n  let filtered = orders.value\n\n  if (searchQuery.value) {\n    filtered = filtered.filter(order => \n      order.orderNumber.toLowerCase().includes(searchQuery.value.toLowerCase()) ||\n      order.user.name.toLowerCase().includes(searchQuery.value.toLowerCase()) ||\n      order.user.email.toLowerCase().includes(searchQuery.value.toLowerCase()) ||\n      order.product.toLowerCase().includes(searchQuery.value.toLowerCase())\n    )\n  }\n\n  if (statusFilter.value !== 'all') {\n    filtered = filtered.filter(order => order.status === statusFilter.value)\n  }\n\n  return filtered\n})\n\nconst totalOrders = computed(() => filteredOrders.value.length)\nconst totalPages = computed(() => Math.ceil(totalOrders.value / pageSize.value))\n\n// 辅助函数\nconst mapOrderStatus = (status: string) => {\n  const statusMap: Record<string, string> = {\n    'pending': 'pending',\n    'processing': 'processing',\n    'completed': 'completed',\n    'failed': 'failed',\n    'success': 'completed'\n  }\n  return statusMap[status] || status\n}\n\nconst getProductName = (productType: string) => {\n  const productMap: Record<string, string> = {\n    '3_month': 'Telegram Premium 3个月',\n    '6_month': 'Telegram Premium 6个月',\n    '12_month': 'Telegram Premium 12个月'\n  }\n  return productMap[productType] || 'Telegram Premium'\n}\n\n// 方法\nconst formatNumber = (num: number) => {\n  return new Intl.NumberFormat('zh-CN').format(num)\n}\n\nconst formatDate = (dateString: string) => {\n  return new Date(dateString).toLocaleString('zh-CN')\n}\n\nconst getStatusColor = (status: string) => {\n  const colors: Record<string, string> = {\n    pending: 'orange',\n    paid: 'blue',\n    processing: 'purple',\n    shipped: 'cyan',\n    completed: 'green',\n    cancelled: 'red',\n    failed: 'red'\n  }\n  return colors[status] || 'gray'\n}\n\nconst getStatusLabel = (status: string) => {\n  const labels: Record<string, string> = {\n    pending: '待付款',\n    paid: '已付款',\n    processing: '处理中',\n    shipped: '已发货',\n    completed: '已完成',\n    cancelled: '已取消',\n    failed: '失败'\n  }\n  return labels[status] || status\n}\n\nconst refreshOrders = () => {\n  fetchOrders()\n}\n\nconst viewOrder = (order: any) => {\n  console.log('查看订单:', order)\n}\n\nconst processOrder = (order: any) => {\n  order.status = 'processing'\n  console.log('处理订单:', order)\n}\n\nconst retryOrder = async (order: any) => {\n  try {\n    const response = await $fetch('/api/orders/retry', {\n      method: 'POST',\n      body: {\n        orderId: order.id\n      }\n    }) as any\n\n    if (response.success) {\n      // 显示成功消息\n      console.log('重新开通订单成功:', response.message)\n      await refreshOrders()\n    } else {\n      console.error('重新开通订单失败:', response.error)\n    }\n  } catch (error) {\n    console.error('重新开通失败:', error)\n  }\n}\n\nconst confirmDeleteOrder = (order: any) => {\n  if (confirm(`确定要删除订单 ${order.orderNumber} 吗？此操作不可撤销。`)) {\n    deleteOrder(order)\n  }\n}\n\nconst deleteOrder = async (order: any) => {\n  try {\n    const response = await $fetch('/api/orders', {\n      method: 'DELETE',\n      body: {\n        orderId: order.id\n      }\n    }) as any\n\n    if (response.success) {\n      // 显示成功消息\n      console.log('删除订单成功:', response.message)\n      await refreshOrders()\n    } else {\n      console.error('删除订单失败:', response.error)\n    }\n  } catch (error) {\n    console.error('删除订单失败:', error)\n  }\n}\n</script>","<template>\n  <div class=\"space-y-6\">\n    <!-- 页面标题 -->\n    <div class=\"flex items-center justify-between\">\n      <div>\n        <h1 class=\"text-2xl font-bold text-white flex items-center gap-3\">\n          <div class=\"w-8 h-8 bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg flex items-center justify-center\">\n            <UIcon name=\"i-heroicons-shopping-bag\" class=\"w-5 h-5 text-[#00dc82]\" />\n          </div>\n          订单管理\n        </h1>\n        <p class=\"mt-1 text-sm text-[#9ca3af]\">管理所有订单信息和交易记录</p>\n      </div>\n      <div class=\"flex gap-2\">\n        <USelect\n          v-model=\"selectedTimeRange\"\n          :options=\"timeRangeOptions\"\n          class=\"w-32\"\n        />\n        <UButton variant=\"outline\" size=\"sm\" @click=\"refreshOrders\">\n          <UIcon name=\"i-heroicons-arrow-path\" class=\"w-4 h-4 mr-2\" />\n          刷新\n        </UButton>\n        <UButton color=\"primary\" size=\"sm\" class=\"bg-[#00dc82] hover:bg-[#00dc82]/80\">\n          <UIcon name=\"i-heroicons-arrow-down-tray\" class=\"w-4 h-4 mr-2\" />\n          导出订单\n        </UButton>\n      </div>\n    </div>\n\n    <!-- 订单统计卡片 -->\n    <div class=\"grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4\">\n      <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg p-4\">\n        <div class=\"flex items-center justify-between\">\n          <div>\n            <p class=\"text-sm text-[#9ca3af]\">总订单数</p>\n            <p class=\"text-2xl font-bold text-white\">{{ formatNumber(stats.totalOrders) }}</p>\n            <div class=\"flex items-center mt-1\">\n              <UIcon \n                :name=\"stats.orderGrowth >= 0 ? 'i-heroicons-arrow-trending-up' : 'i-heroicons-arrow-trending-down'\" \n                :class=\"stats.orderGrowth >= 0 ? 'text-green-400' : 'text-red-400'\"\n                class=\"w-4 h-4 mr-1\"\n              />\n              <span :class=\"stats.orderGrowth >= 0 ? 'text-green-400' : 'text-red-400'\" class=\"text-sm\">\n                {{ Math.abs(stats.orderGrowth) }}%\n              </span>\n              <span class=\"text-[#9ca3af] text-sm ml-1\">vs 上期</span>\n            </div>\n          </div>\n          <div class=\"w-12 h-12 bg-blue-500/10 rounded-lg flex items-center justify-center\">\n            <UIcon name=\"i-heroicons-shopping-bag\" class=\"w-6 h-6 text-blue-400\" />\n          </div>\n        </div>\n      </div>\n\n      <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg p-4\">\n        <div class=\"flex items-center justify-between\">\n          <div>\n            <p class=\"text-sm text-[#9ca3af]\">总销售额</p>\n            <p class=\"text-2xl font-bold text-white\">¥{{ formatNumber(stats.totalRevenue) }}</p>\n            <div class=\"flex items-center mt-1\">\n              <UIcon \n                :name=\"stats.revenueGrowth >= 0 ? 'i-heroicons-arrow-trending-up' : 'i-heroicons-arrow-trending-down'\" \n                :class=\"stats.revenueGrowth >= 0 ? 'text-green-400' : 'text-red-400'\"\n                class=\"w-4 h-4 mr-1\"\n              />\n              <span :class=\"stats.revenueGrowth >= 0 ? 'text-green-400' : 'text-red-400'\" class=\"text-sm\">\n                {{ Math.abs(stats.revenueGrowth) }}%\n              </span>\n              <span class=\"text-[#9ca3af] text-sm ml-1\">vs 上期</span>\n            </div>\n          </div>\n          <div class=\"w-12 h-12 bg-green-500/10 rounded-lg flex items-center justify-center\">\n            <UIcon name=\"i-heroicons-currency-dollar\" class=\"w-6 h-6 text-green-400\" />\n          </div>\n        </div>\n      </div>\n\n      <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg p-4\">\n        <div class=\"flex items-center justify-between\">\n          <div>\n            <p class=\"text-sm text-[#9ca3af]\">待处理订单</p>\n            <p class=\"text-2xl font-bold text-white\">{{ formatNumber(stats.pendingOrders) }}</p>\n            <div class=\"flex items-center mt-1\">\n              <UIcon name=\"i-heroicons-clock\" class=\"w-4 h-4 mr-1 text-orange-400\" />\n              <span class=\"text-orange-400 text-sm\">需要处理</span>\n            </div>\n          </div>\n          <div class=\"w-12 h-12 bg-orange-500/10 rounded-lg flex items-center justify-center\">\n            <UIcon name=\"i-heroicons-clock\" class=\"w-6 h-6 text-orange-400\" />\n          </div>\n        </div>\n      </div>\n\n      <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg p-4\">\n        <div class=\"flex items-center justify-between\">\n          <div>\n            <p class=\"text-sm text-[#9ca3af]\">完成率</p>\n            <p class=\"text-2xl font-bold text-white\">{{ stats.completionRate }}%</p>\n            <div class=\"flex items-center mt-1\">\n              <UIcon name=\"i-heroicons-check-circle\" class=\"w-4 h-4 mr-1 text-green-400\" />\n              <span class=\"text-green-400 text-sm\">已完成</span>\n            </div>\n          </div>\n          <div class=\"w-12 h-12 bg-purple-500/10 rounded-lg flex items-center justify-center\">\n            <UIcon name=\"i-heroicons-chart-pie\" class=\"w-6 h-6 text-purple-400\" />\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 订单列表 -->\n    <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg\">\n      <div class=\"p-4 border-b border-[#2a2a2b]\">\n        <div class=\"flex items-center justify-between\">\n          <h2 class=\"text-lg font-semibold text-white\">订单列表</h2>\n          <div class=\"flex gap-2\">\n            <UInput\n              v-model=\"searchQuery\"\n              placeholder=\"搜索订单号、用户...\"\n              class=\"w-64\"\n              icon=\"i-heroicons-magnifying-glass\"\n            />\n            <USelect\n              v-model=\"statusFilter\"\n              :options=\"statusOptions\"\n              class=\"w-32\"\n            />\n          </div>\n        </div>\n      </div>\n\n      <div class=\"overflow-x-auto\">\n        <table class=\"w-full\">\n          <thead class=\"bg-[#0c0c0d]\">\n            <tr>\n              <th class=\"px-4 py-3 text-left text-xs font-medium text-[#9ca3af] uppercase tracking-wider\">订单号</th>\n              <th class=\"px-4 py-3 text-left text-xs font-medium text-[#9ca3af] uppercase tracking-wider\">用户</th>\n              <th class=\"px-4 py-3 text-left text-xs font-medium text-[#9ca3af] uppercase tracking-wider\">商品</th>\n              <th class=\"px-4 py-3 text-left text-xs font-medium text-[#9ca3af] uppercase tracking-wider\">金额</th>\n              <th class=\"px-4 py-3 text-left text-xs font-medium text-[#9ca3af] uppercase tracking-wider\">状态</th>\n              <th class=\"px-4 py-3 text-left text-xs font-medium text-[#9ca3af] uppercase tracking-wider\">创建时间</th>\n              <th class=\"px-4 py-3 text-left text-xs font-medium text-[#9ca3af] uppercase tracking-wider\">操作</th>\n            </tr>\n          </thead>\n          <tbody class=\"divide-y divide-[#2a2a2b]\">\n            <tr v-for=\"order in filteredOrders\" :key=\"order.id\" class=\"hover:bg-[#2a2a2b]/50\">\n              <td class=\"px-4 py-3\">\n                <div class=\"text-sm font-medium text-white\">{{ order.orderNumber }}</div>\n              </td>\n              <td class=\"px-4 py-3\">\n                <div class=\"flex items-center\">\n                  <div class=\"w-8 h-8 bg-[#2a2a2b] rounded-full flex items-center justify-center mr-3\">\n                    <span class=\"text-xs font-medium text-white\">{{ order.user.name.charAt(0) }}</span>\n                  </div>\n                  <div>\n                    <div class=\"text-sm font-medium text-white\">{{ order.user.name }}</div>\n                    <div class=\"text-sm text-[#9ca3af]\">{{ order.user.email }}</div>\n                  </div>\n                </div>\n              </td>\n              <td class=\"px-4 py-3\">\n                <div class=\"text-sm text-white\">{{ order.product }}</div>\n                <div class=\"text-sm text-[#9ca3af]\">数量: {{ order.quantity }}</div>\n              </td>\n              <td class=\"px-4 py-3\">\n                <div class=\"text-sm font-medium text-white\">¥{{ formatNumber(order.amount) }}</div>\n              </td>\n              <td class=\"px-4 py-3\">\n                <UBadge\n                  :color=\"getStatusColor(order.status) as any\"\n                  variant=\"subtle\"\n                  size=\"sm\"\n                >\n                  {{ getStatusLabel(order.status) }}\n                </UBadge>\n              </td>\n              <td class=\"px-4 py-3 text-sm text-[#9ca3af]\">{{ formatDate(order.createdAt) }}</td>\n              <td class=\"px-4 py-3\">\n                <div class=\"flex gap-2\">\n                  <UButton variant=\"ghost\" size=\"xs\" @click=\"viewOrder(order)\">\n                    <UIcon name=\"i-heroicons-eye\" class=\"w-4 h-4\" />\n                  </UButton>\n                  <UButton \n                    v-if=\"order.status === 'cancelled' || order.status === 'failed'\"\n                    variant=\"ghost\" \n                    size=\"xs\" \n                    color=\"blue\"\n                    @click=\"retryOrder(order)\"\n                    title=\"重新开通\"\n                  >\n                    <UIcon name=\"i-heroicons-arrow-path\" class=\"w-4 h-4\" />\n                  </UButton>\n                  <UButton \n                    v-if=\"order.status === 'pending'\"\n                    variant=\"ghost\" \n                    size=\"xs\" \n                    color=\"green\"\n                    @click=\"processOrder(order)\"\n                  >\n                    <UIcon name=\"i-heroicons-check\" class=\"w-4 h-4\" />\n                  </UButton>\n                  <UButton \n                    variant=\"ghost\" \n                    size=\"xs\" \n                    color=\"red\"\n                    @click=\"confirmDeleteOrder(order)\"\n                    title=\"删除订单\"\n                  >\n                    <UIcon name=\"i-heroicons-trash\" class=\"w-4 h-4\" />\n                  </UButton>\n                </div>\n              </td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <!-- 分页 -->\n      <div class=\"px-4 py-3 border-t border-[#2a2a2b] flex items-center justify-between\">\n        <div class=\"text-sm text-[#9ca3af]\">\n          显示 {{ (currentPage - 1) * pageSize + 1 }} 到 {{ Math.min(currentPage * pageSize, totalOrders) }} 条，共 {{ totalOrders }} 条\n        </div>\n        <div class=\"flex gap-2\">\n          <UButton \n            variant=\"outline\" \n            size=\"sm\" \n            :disabled=\"currentPage === 1\"\n            @click=\"currentPage--\"\n          >\n            上一页\n          </UButton>\n          <UButton \n            variant=\"outline\" \n            size=\"sm\" \n            :disabled=\"currentPage === totalPages\"\n            @click=\"currentPage++\"\n          >\n            下一页\n          </UButton>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\n// 页面元数据\ndefinePageMeta({\n  middleware: 'auth'\n})\n\n// 响应式数据\nconst searchQuery = ref('')\nconst statusFilter = ref('all')\nconst selectedTimeRange = ref('7d')\nconst currentPage = ref(1)\nconst pageSize = ref(10)\n\n// 时间范围选项\nconst timeRangeOptions = [\n  { label: '今天', value: '1d' },\n  { label: '7天', value: '7d' },\n  { label: '30天', value: '30d' },\n  { label: '90天', value: '90d' }\n]\n\n// 状态选项\nconst statusOptions = [\n  { label: '全部', value: 'all' },\n  { label: '待付款', value: 'pending' },\n  { label: '已付款', value: 'paid' },\n  { label: '处理中', value: 'processing' },\n  { label: '已发货', value: 'shipped' },\n  { label: '已完成', value: 'completed' },\n  { label: '已取消', value: 'cancelled' }\n]\n\n// 定义订单类型\ninterface Order {\n  id: string\n  orderNumber: string\n  user: {\n    name: string\n    email: string\n  }\n  product: string\n  quantity: number\n  amount: number\n  status: string\n  createdAt: string\n}\n\n// 响应式数据\nconst orders = ref<Order[]>([])\nconst loading = ref(false)\n\n// 统计数据\nconst stats = computed(() => {\n  const totalOrders = orders.value.length\n  const totalRevenue = orders.value.reduce((sum: number, order: Order) => sum + order.amount, 0)\n  const successOrders = orders.value.filter((order: Order) => order.status === 'completed').length\n  const failedOrders = orders.value.filter((order: Order) => order.status === 'cancelled').length\n  const completionRate = totalOrders > 0 ? ((successOrders / totalOrders) * 100).toFixed(1) : '0'\n  \n  return {\n    totalOrders,\n    totalRevenue,\n    pendingOrders: failedOrders,\n    completionRate: parseFloat(completionRate),\n    orderGrowth: 12.5, // 暂时保持静态值\n    revenueGrowth: 18.3 // 暂时保持静态值\n  }\n})\n\n// 获取订单数据\nconst fetchOrders = async () => {\n  loading.value = true\n  try {\n    const response = await $fetch('/api/orders') as any\n    if (response.success) {\n      orders.value = response.data.map((order: any) => ({\n        id: order.id,\n        orderNumber: `ORD-${order.id}`,\n        user: {\n          name: order.username,\n          email: `${order.username}@telegram.com`\n        },\n        product: getProductName(order.productType),\n        quantity: 1,\n        amount: order.amount,\n        status: mapOrderStatus(order.status),\n        createdAt: order.createdAt\n      }))\n    }\n  } catch (error) {\n    console.error('获取订单数据失败:', error)\n  } finally {\n    loading.value = false\n  }\n}\n\n// 页面加载时获取数据\nonMounted(() => {\n  fetchOrders()\n})\n\n// 计算属性\nconst filteredOrders = computed(() => {\n  let filtered = orders.value\n\n  if (searchQuery.value) {\n    filtered = filtered.filter(order => \n      order.orderNumber.toLowerCase().includes(searchQuery.value.toLowerCase()) ||\n      order.user.name.toLowerCase().includes(searchQuery.value.toLowerCase()) ||\n      order.user.email.toLowerCase().includes(searchQuery.value.toLowerCase()) ||\n      order.product.toLowerCase().includes(searchQuery.value.toLowerCase())\n    )\n  }\n\n  if (statusFilter.value !== 'all') {\n    filtered = filtered.filter(order => order.status === statusFilter.value)\n  }\n\n  return filtered\n})\n\nconst totalOrders = computed(() => filteredOrders.value.length)\nconst totalPages = computed(() => Math.ceil(totalOrders.value / pageSize.value))\n\n// 辅助函数\nconst mapOrderStatus = (status: string) => {\n  const statusMap: Record<string, string> = {\n    'pending': 'pending',\n    'processing': 'processing',\n    'completed': 'completed',\n    'failed': 'failed',\n    'success': 'completed'\n  }\n  return statusMap[status] || status\n}\n\nconst getProductName = (productType: string) => {\n  const productMap: Record<string, string> = {\n    '3_month': 'Telegram Premium 3个月',\n    '6_month': 'Telegram Premium 6个月',\n    '12_month': 'Telegram Premium 12个月'\n  }\n  return productMap[productType] || 'Telegram Premium'\n}\n\n// 方法\nconst formatNumber = (num: number) => {\n  return new Intl.NumberFormat('zh-CN').format(num)\n}\n\nconst formatDate = (dateString: string) => {\n  return new Date(dateString).toLocaleString('zh-CN')\n}\n\nconst getStatusColor = (status: string) => {\n  const colors: Record<string, string> = {\n    pending: 'orange',\n    paid: 'blue',\n    processing: 'purple',\n    shipped: 'cyan',\n    completed: 'green',\n    cancelled: 'red',\n    failed: 'red'\n  }\n  return colors[status] || 'gray'\n}\n\nconst getStatusLabel = (status: string) => {\n  const labels: Record<string, string> = {\n    pending: '待付款',\n    paid: '已付款',\n    processing: '处理中',\n    shipped: '已发货',\n    completed: '已完成',\n    cancelled: '已取消',\n    failed: '失败'\n  }\n  return labels[status] || status\n}\n\nconst refreshOrders = () => {\n  fetchOrders()\n}\n\nconst viewOrder = (order: any) => {\n  console.log('查看订单:', order)\n}\n\nconst processOrder = (order: any) => {\n  order.status = 'processing'\n  console.log('处理订单:', order)\n}\n\nconst retryOrder = async (order: any) => {\n  try {\n    const response = await $fetch('/api/orders/retry', {\n      method: 'POST',\n      body: {\n        orderId: order.id\n      }\n    }) as any\n\n    if (response.success) {\n      // 显示成功消息\n      console.log('重新开通订单成功:', response.message)\n      await refreshOrders()\n    } else {\n      console.error('重新开通订单失败:', response.error)\n    }\n  } catch (error) {\n    console.error('重新开通失败:', error)\n  }\n}\n\nconst confirmDeleteOrder = (order: any) => {\n  if (confirm(`确定要删除订单 ${order.orderNumber} 吗？此操作不可撤销。`)) {\n    deleteOrder(order)\n  }\n}\n\nconst deleteOrder = async (order: any) => {\n  try {\n    const response = await $fetch('/api/orders', {\n      method: 'DELETE',\n      body: {\n        orderId: order.id\n      }\n    }) as any\n\n    if (response.success) {\n      // 显示成功消息\n      console.log('删除订单成功:', response.message)\n      await refreshOrders()\n    } else {\n      console.error('删除订单失败:', response.error)\n    }\n  } catch (error) {\n    console.error('删除订单失败:', error)\n  }\n}\n</script>"],"version":3}