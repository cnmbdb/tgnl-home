{"file":"bots-BnAOkfjA.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;EAuVA,MAAM,YAAY,IAAI;GAEpB,OAAO;GACP,gBAAgB;GAChB,SAAS;GACT,mBAAmB;GACnB,WAAW;GAGX,YAAY;GACZ,UAAU;GACV,WAAW;GAGX,SAAS;GACT,WAAW;GACX,gBAAgB;GAGhB,QAAQ;GACR,QAAQ;GACR,YAAY;GACZ,QAAQ;GACR,QAAQ;GAGR,YAAY;GACb,CAAA;EAGD,MAAM,WAAW,IAAI,MAAK;EAC1B,MAAM,YAAY,IAAI,MAAK;EAC3B,IAAI,cAAc;EAGlB,MAAM,eAAe,IAAI,MAAK;EAC9B,MAAM,sBAAsB,IAAI,MAAK;EACrC,MAAM,kBAAkB,IAAI,EAAC;EAC7B,MAAM,gBAAgB,IAAI,GAAE;EAG5B,MAAM,mBAAmB,IAAI,MAAK;EAQlC,MAAM,2BAA2B;AAE/B,OAAI,YACF,cAAa,YAAW;AAI1B,aAAU,QAAQ;AAGlB,iBAAc,iBAAiB;AAC7B,gBAAW;MACV,IAAI;;EAGT,MAAM,8BAA8B;AAClC,WAAQ,IAAI,YAAY,iBAAiB,MAAK;AAE9C,OAAI,iBAAiB,MACnB,aAAW;;EAIf,MAAM,aAAa,YAAY;AAC7B,OAAI;AACF,aAAS,QAAQ;AAEjB,YAAQ,IAAI,SAAS,UAAU,MAAK;IAGpC,MAAM,WAAW,MAAM,OAAO,mBAAmB;KAC/C,QAAQ;KACR,MAAM;MACJ,GAAG,UAAU;MACb,WAAW,iBAAiB;MAC9B;KACD,CAAA;AAED,QAAI,SAAS,SAAS;AACpB,aAAQ,IAAI,SAAQ;AAGpB,eAAU,QAAQ;AAGlB,SAAI,iBAAiB,MAEL,WAAS,CACjB,IAAI;MACR,OAAO;MACP,aAAa;MACb,MAAM;MACN,OAAO;MACR,CAAA;AAIH,sBAAiB;AACf,gBAAU,QAAQ;QACjB,IAAI;WACF;AACL,aAAQ,MAAM,WAAW,SAAS,MAAK;AACzB,eAAS,CACjB,IAAI;MACR,OAAO;MACP,aAAa,SAAS,SAAS;MAC/B,MAAM;MACN,OAAO;MACR,CAAA;;YAGI,OAAO;AACd,YAAQ,MAAM,WAAW,MAAK;AAChB,cAAS,CACjB,IAAI;KACR,OAAO;KACP,aAAa;KACb,MAAM;KACN,OAAO;KACR,CAAA;aACO;AACR,aAAS,QAAQ;;;EAIrB,MAAM,aAAa,YAAY;AAC7B,OAAI;AACF,iBAAa,QAAQ;AACrB,wBAAoB,QAAQ;AAC5B,oBAAgB,QAAQ;AACxB,kBAAc,QAAQ;IAGtB,MAAM,kBAAkB,UAAU,WAAW;AAC3C,qBAAgB,QAAQ;AACxB,mBAAc,QAAQ;;IAIxB,MAAM,WAAW,MAAM,OAAO,oBAAoB,EAChD,QAAQ,QACT,CAAA;AAED,QAAI,SAAS,SAAS;AAEpB,oBAAe,IAAI,cAAa;AAChC,WAAM,IAAI,SAAQ,YAAW,WAAW,SAAS,IAAK,CAAA;AAEtD,oBAAe,IAAI,YAAW;AAC9B,WAAM,IAAI,SAAQ,YAAW,WAAW,SAAS,IAAK,CAAA;AAEtD,oBAAe,IAAI,aAAY;AAC/B,WAAM,IAAI,SAAQ,YAAW,WAAW,SAAS,KAAK,CAAA;AAEtD,oBAAe,KAAK,OAAM;AAG1B,sBAAiB;AACf,0BAAoB,QAAQ;AAC5B,sBAAgB,QAAQ;AACxB,oBAAc,QAAQ;QACrB,IAAI;AAEP,aAAQ,IAAI,UAAS;WAChB;AACL,aAAQ,MAAM,YAAY,SAAS,MAAK;AACxC,mBAAc,QAAQ,WAAW,SAAS;;YAGrC,OAAO;AACd,YAAQ,MAAM,YAAY,MAAK;AAC/B,kBAAc,QAAQ,WAAW,MAAM;aAC/B;AACR,iBAAa,QAAQ;;;;;;;;;;4CA5gBlB,OAAM,aAAW,EAAA,OAAA,CAAA,CAAA,+NAAA;;IAML,MAAK;IAAuB,OAAM;;;;IAOpC,SAAQ;IAAU,MAAK;;sBAGtB,GAAA,SAAA,WAAA,aAAA;;;OAFD,MAAK;OAAyB,OAAM;;;oBAA3C,YAA4D,kBAAA;MAArD,MAAK;MAAyB,OAAM;yBAAiB,SAE9D,CAAA;;;;;IACS,OAAM;IAAU,MAAK;IAAK,OAAM;;sBAG/B,GAAA,SAAA,WAAA,aAAA;;;OAFD,MAAK;OAAmB,OAAM;;;oBAArC,YAAsD,kBAAA;MAA/C,MAAK;MAAmB,OAAM;yBAAiB,UAExD,CAAA;;;;;OAYkB,MAAA,SAAQ,CAAA,OAAA,mBAAA,mBAAA;IAAE,OAAM;IAAS,SAAQ;IAAS,MAAK;;sBAGpD,GAAA,SAAA,WAAA,aAAA;;;OAFA,MAAK;OAAyB,OAAM;;;oBAA3C,YAAyE,kBAAA;MAAlE,MAAK;MAAyB,OAAM;yBAA8B,WAE3E,CAAA;;;;YACmB,MAAA,UAAS,CAAA,OAAA,mBAAA,mBAAA;IAAE,OAAM;IAAQ,SAAQ;IAAS,MAAK;;sBAGzD,GAAA,SAAA,WAAA,aAAA;;;OAFA,MAAK;OAAoB,OAAM;;;oBAAtC,YAAuD,kBAAA;MAAhD,MAAK;MAAoB,OAAM;yBAAiB,QAEzD,CAAA;;;;;;;IAIS,MAAK;IAAmB,OAAM;;;;gBAG1B,MAAA,iBAAgB;iEAAhB,iBAAgB,QAAA,SAAA;IACzB,MAAK;IACJ,UAAQ;;;;IAKX,OAAM;IACN,MAAK;IACL,OAAM;IACL,SAAO;IACP,SAAS,MAAA,aAAY;IACrB,UAAU,MAAA,iBAAA;;sBAIH,GAAA,SAAA,WAAA,aAAA;;;OAFD,MAAK;OAAyB,OAAM;;;oBAA3C,YAA4D,kBAAA;MAArD,MAAK;MAAyB,OAAM;yBAAiB,UAE9D,CAAA;;;;;IAEE,OAAM;IACN,MAAK;IACL,OAAM;IACL,SAAO;IACP,SAAS,MAAA,SAAA;;sBAIF,GAAA,SAAA,WAAA,aAAA;;;OAFD,MAAK;OAAoB,OAAM;;iCACnC,MAAA,iBAAgB,GAAA,WAAA,OAAA,GAAA;oBADnB,YAAuD,kBAAA;MAAhD,MAAK;MAAoB,OAAM;yBAAiB,MACvD,gBAAG,MAAA,iBAAgB,GAAA,WAAA,OAAA,EAAA,EAAA,CAAA;;;;;OAMd,MAAA,oBAAmB,CAAA,OAAA,0JAAA,eAIf,MAAA,gBAAe,CAAA,CAAA,yJAAA,eAAA,EAAA,OAKL,MAAA,gBAAe,GAAA,KAAA,CAAA,CAAA,yDAAA,eAGQ,MAAA,cAAa,CAAA,CAAA,oBAAA;;;;IASlD,MAAK;IAA0B,OAAM;;;;gBAO/B,MAAA,UAAS,CAAC;uCAAV,MAAA,UAAS,CAAC,QAAK;IACxB,aAAY;IACZ,OAAM;IACL,SAAO;;;;gBAOC,MAAA,UAAS,CAAC;uCAAV,MAAA,UAAS,CAAC,UAAO;IAC1B,aAAY;IACZ,OAAM;IACL,SAAO;;;;gBAOC,MAAA,UAAS,CAAC;uCAAV,MAAA,UAAS,CAAC,oBAAiB;IACpC,aAAY;IACZ,OAAM;IACL,SAAO;;;;gBAOC,MAAA,UAAS,CAAC;uCAAV,MAAA,UAAS,CAAC,iBAAc;IACjC,aAAY;IACZ,OAAM;IACL,SAAO;;;;gBAOC,MAAA,UAAS,CAAC;uCAAV,MAAA,UAAS,CAAC,YAAS;IAC5B,aAAY;IACZ,OAAM;IACL,SAAO;;;;IASL,MAAK;IAA8B,OAAM;;;;gBAOnC,MAAA,UAAS,CAAC;uCAAV,MAAA,UAAS,CAAC,aAAU;IAC7B,MAAK;IACL,aAAY;IACZ,OAAM;IACL,SAAO;;;;gBAOC,MAAA,UAAS,CAAC;uCAAV,MAAA,UAAS,CAAC,WAAQ;IAC3B,MAAK;IACL,aAAY;IACZ,OAAM;IACL,SAAO;;;;gBAOC,MAAA,UAAS,CAAC;uCAAV,MAAA,UAAS,CAAC,YAAS;IAC5B,MAAK;IACL,aAAY;IACZ,OAAM;IACL,SAAO;;;;IASL,MAAK;IAAwB,OAAM;;;;gBAO7B,MAAA,UAAS,CAAC;uCAAV,MAAA,UAAS,CAAC,UAAO;IAC1B,aAAY;IACZ,OAAM;IACL,SAAO;;;;gBAOC,MAAA,UAAS,CAAC;uCAAV,MAAA,UAAS,CAAC,YAAS;IAC5B,aAAY;IACZ,OAAM;IACL,MAAM;IACN,SAAO;;;;gBAOC,MAAA,UAAS,CAAC;uCAAV,MAAA,UAAS,CAAC,iBAAc;IACjC,aAAY;IACZ,OAAM;IACL,MAAM;IACN,SAAO;;;;IASL,MAAK;IAA2B,OAAM;;;;gBAOhC,MAAA,UAAS,CAAC;uCAAV,MAAA,UAAS,CAAC,SAAM;IACzB,aAAY;IACZ,OAAM;IACL,SAAO;;;;gBAOC,MAAA,UAAS,CAAC;uCAAV,MAAA,UAAS,CAAC,SAAM;IACzB,MAAK;IACL,aAAY;IACZ,OAAM;IACL,SAAO;;;;gBAOC,MAAA,UAAS,CAAC;uCAAV,MAAA,UAAS,CAAC,SAAM;IACzB,aAAY;IACZ,OAAM;IACL,SAAO;;;;gBAOC,MAAA,UAAS,CAAC;uCAAV,MAAA,UAAS,CAAC,SAAM;IACzB,aAAY;IACZ,OAAM;IACL,SAAO;;;;gBAOC,MAAA,UAAS,CAAC;uCAAV,MAAA,UAAS,CAAC,aAAU;IAC7B,MAAK;IACL,aAAY;IACZ,OAAM;IACL,SAAO;;;;IASL,MAAK;IAAkB,OAAM;;;;gBAUvB,MAAA,UAAS,CAAC;uCAAV,MAAA,UAAS,CAAC,aAAU;IAC7B,aAAY;IACZ,OAAM;IACL,SAAO","names":[],"sources":["../../../../pages/bots/index.vue"],"sourcesContent":["<template>\n  <div class=\"space-y-6\">\n    <!-- 页面标题 -->\n    <div class=\"flex items-center justify-between\">\n      <div>\n        <h1 class=\"text-2xl font-bold text-white flex items-center gap-3\">\n          <div class=\"w-8 h-8 bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg flex items-center justify-center\">\n            <UIcon name=\"i-heroicons-cpu-chip\" class=\"w-5 h-5 text-[#00dc82]\" />\n          </div>\n          机器人管理\n        </h1>\n        <p class=\"mt-1 text-sm text-[#9ca3af]\">监控和管理 Telegram 机器人状态</p>\n      </div>\n      <div class=\"flex gap-2\">\n        <UButton variant=\"outline\" size=\"sm\">\n          <UIcon name=\"i-heroicons-arrow-path\" class=\"w-4 h-4 mr-2\" />\n          刷新状态\n        </UButton>\n        <UButton color=\"primary\" size=\"sm\" class=\"bg-[#00dc82] hover:bg-[#00dc82]/80\">\n          <UIcon name=\"i-heroicons-plus\" class=\"w-4 h-4 mr-2\" />\n          添加机器人\n        </UButton>\n      </div>\n    </div>\n\n\n\n    <!-- 机器人配置 -->\n    <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg\">\n      <div class=\"px-4 py-3 border-b border-[#2a2a2b]\">\n        <div class=\"flex items-center justify-between\">\n          <h3 class=\"text-lg font-medium text-white\">机器人配置</h3>\n          <div class=\"flex items-center gap-2\">\n            <UBadge v-if=\"isSaving\" color=\"yellow\" variant=\"subtle\" size=\"sm\">\n              <UIcon name=\"i-heroicons-arrow-path\" class=\"w-3 h-3 mr-1 animate-spin\" />\n              保存中...\n            </UBadge>\n            <UBadge v-else-if=\"lastSaved\" color=\"green\" variant=\"subtle\" size=\"sm\">\n              <UIcon name=\"i-heroicons-check\" class=\"w-3 h-3 mr-1\" />\n              已保存\n            </UBadge>\n            \n            <!-- 热更新配置开关 -->\n            <div class=\"flex items-center gap-2 px-3 py-1 bg-[#1a1a1b] rounded-lg border border-[#2a2a2b]\">\n              <UIcon name=\"i-heroicons-bolt\" class=\"w-4 h-4 text-[#00dc82]\" />\n              <span class=\"text-sm text-[#9ca3af]\">热更新</span>\n              <UToggle \n                v-model=\"hotReloadEnabled\" \n                size=\"sm\"\n                @change=\"handleHotReloadToggle\"\n              />\n            </div>\n            \n            <UButton \n              color=\"primary\" \n              size=\"sm\" \n              class=\"bg-[#00dc82] hover:bg-[#00dc82]/80\"\n              @click=\"restartBot\"\n              :loading=\"isRestarting\"\n              :disabled=\"hotReloadEnabled\"\n            >\n              <UIcon name=\"i-heroicons-arrow-path\" class=\"w-4 h-4 mr-2\" />\n              重启机器人\n            </UButton>\n            <UButton \n              color=\"primary\" \n              size=\"sm\" \n              class=\"bg-[#00dc82] hover:bg-[#00dc82]/80\"\n              @click=\"saveConfig\"\n              :loading=\"isSaving\"\n            >\n              <UIcon name=\"i-heroicons-check\" class=\"w-4 h-4 mr-2\" />\n              {{ hotReloadEnabled ? '保存并热更新' : '立即保存' }}\n            </UButton>\n          </div>\n        </div>\n        \n        <!-- 重启进度条 -->\n        <div v-if=\"showRestartProgress\" class=\"mt-3 flex justify-end\">\n          <div class=\"w-48\">\n            <div class=\"flex items-center justify-between text-xs text-[#9ca3af] mb-1\">\n              <span>重启进度</span>\n              <span>{{ restartProgress }}%</span>\n            </div>\n            <div class=\"w-full bg-[#2a2a2b] rounded-full h-2\">\n              <div \n                class=\"bg-[#00dc82] h-2 rounded-full transition-all duration-300 ease-out\"\n                :style=\"{ width: restartProgress + '%' }\"\n              ></div>\n            </div>\n            <div class=\"text-xs text-[#9ca3af] mt-1\">{{ restartStatus }}</div>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"p-4 space-y-6\">\n        <!-- 基础配置 -->\n        <div>\n          <h4 class=\"text-md font-medium text-white mb-3 flex items-center\">\n            <UIcon name=\"i-heroicons-cog-6-tooth\" class=\"w-4 h-4 mr-2\" />\n            基础配置\n          </h4>\n          <div class=\"grid grid-cols-1 gap-4 md:grid-cols-2\">\n            <div>\n              <label class=\"block text-sm font-medium text-[#9ca3af] mb-2\">Bot Token</label>\n              <UInput\n                v-model=\"botConfig.token\"\n                placeholder=\"请输入机器人令牌\"\n                class=\"bg-[#0c0c0d]\"\n                @input=\"handleConfigChange\"\n              />\n            </div>\n            \n            <div>\n              <label class=\"block text-sm font-medium text-[#9ca3af] mb-2\">管理员 ID</label>\n              <UInput\n                v-model=\"botConfig.adminId\"\n                placeholder=\"请输入管理员ID\"\n                class=\"bg-[#0c0c0d]\"\n                @input=\"handleConfigChange\"\n              />\n            </div>\n            \n            <div>\n              <label class=\"block text-sm font-medium text-[#9ca3af] mb-2\">客服链接</label>\n              <UInput\n                v-model=\"botConfig.customerServiceId\"\n                placeholder=\"请输入客服链接\"\n                class=\"bg-[#0c0c0d]\"\n                @input=\"handleConfigChange\"\n              />\n            </div>\n            \n            <div>\n              <label class=\"block text-sm font-medium text-[#9ca3af] mb-2\">钱包地址</label>\n              <UInput\n                v-model=\"botConfig.controlAddress\"\n                placeholder=\"请输入钱包地址\"\n                class=\"bg-[#0c0c0d]\"\n                @input=\"handleConfigChange\"\n              />\n            </div>\n            \n            <div class=\"md:col-span-2\">\n              <label class=\"block text-sm font-medium text-[#9ca3af] mb-2\">机器人连接</label>\n              <UInput\n                v-model=\"botConfig.tiaozhuan\"\n                placeholder=\"请输入机器人连接\"\n                class=\"bg-[#0c0c0d]\"\n                @input=\"handleConfigChange\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <!-- 价格配置 -->\n        <div>\n          <h4 class=\"text-md font-medium text-white mb-3 flex items-center\">\n            <UIcon name=\"i-heroicons-currency-dollar\" class=\"w-4 h-4 mr-2\" />\n            价格配置\n          </h4>\n          <div class=\"grid grid-cols-1 gap-4 md:grid-cols-3\">\n            <div>\n              <label class=\"block text-sm font-medium text-[#9ca3af] mb-2\">3个月价格</label>\n              <UInput\n                v-model=\"botConfig.threePrice\"\n                type=\"number\"\n                placeholder=\"请输入3个月价格\"\n                class=\"bg-[#0c0c0d]\"\n                @input=\"handleConfigChange\"\n              />\n            </div>\n            \n            <div>\n              <label class=\"block text-sm font-medium text-[#9ca3af] mb-2\">6个月价格</label>\n              <UInput\n                v-model=\"botConfig.sixPrice\"\n                type=\"number\"\n                placeholder=\"请输入6个月价格\"\n                class=\"bg-[#0c0c0d]\"\n                @input=\"handleConfigChange\"\n              />\n            </div>\n            \n            <div>\n              <label class=\"block text-sm font-medium text-[#9ca3af] mb-2\">年费价格</label>\n              <UInput\n                v-model=\"botConfig.yearPrice\"\n                type=\"number\"\n                placeholder=\"请输入年费价格\"\n                class=\"bg-[#0c0c0d]\"\n                @input=\"handleConfigChange\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <!-- 资源配置 -->\n        <div>\n          <h4 class=\"text-md font-medium text-white mb-3 flex items-center\">\n            <UIcon name=\"i-heroicons-globe-alt\" class=\"w-4 h-4 mr-2\" />\n            资源配置\n          </h4>\n          <div class=\"grid grid-cols-1 gap-4\">\n            <div>\n              <label class=\"block text-sm font-medium text-[#9ca3af] mb-2\">资源哈希</label>\n              <UInput\n                v-model=\"botConfig.resHash\"\n                placeholder=\"请输入资源哈希\"\n                class=\"bg-[#0c0c0d]\"\n                @input=\"handleConfigChange\"\n              />\n            </div>\n            \n            <div>\n              <label class=\"block text-sm font-medium text-[#9ca3af] mb-2\">资源Cookie</label>\n              <UTextarea\n                v-model=\"botConfig.resCookie\"\n                placeholder=\"请输入资源Cookie\"\n                class=\"bg-[#0c0c0d]\"\n                :rows=\"3\"\n                @input=\"handleConfigChange\"\n              />\n            </div>\n            \n            <div>\n              <label class=\"block text-sm font-medium text-[#9ca3af] mb-2\">钱包助记词</label>\n              <UTextarea\n                v-model=\"botConfig.walletMnemonic\"\n                placeholder=\"请输入钱包助记词（用空格分隔）\"\n                class=\"bg-[#0c0c0d]\"\n                :rows=\"2\"\n                @input=\"handleConfigChange\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <!-- 数据库配置 -->\n        <div>\n          <h4 class=\"text-md font-medium text-white mb-3 flex items-center\">\n            <UIcon name=\"i-heroicons-circle-stack\" class=\"w-4 h-4 mr-2\" />\n            数据库配置\n          </h4>\n          <div class=\"grid grid-cols-1 gap-4 md:grid-cols-2\">\n            <div>\n              <label class=\"block text-sm font-medium text-[#9ca3af] mb-2\">数据库主机</label>\n              <UInput\n                v-model=\"botConfig.dbHost\"\n                placeholder=\"请输入数据库主机地址\"\n                class=\"bg-[#0c0c0d]\"\n                @input=\"handleConfigChange\"\n              />\n            </div>\n            \n            <div>\n              <label class=\"block text-sm font-medium text-[#9ca3af] mb-2\">数据库端口</label>\n              <UInput\n                v-model=\"botConfig.dbPort\"\n                type=\"number\"\n                placeholder=\"请输入数据库端口\"\n                class=\"bg-[#0c0c0d]\"\n                @input=\"handleConfigChange\"\n              />\n            </div>\n            \n            <div>\n              <label class=\"block text-sm font-medium text-[#9ca3af] mb-2\">数据库名称</label>\n              <UInput\n                v-model=\"botConfig.dbName\"\n                placeholder=\"请输入数据库名称\"\n                class=\"bg-[#0c0c0d]\"\n                @input=\"handleConfigChange\"\n              />\n            </div>\n            \n            <div>\n              <label class=\"block text-sm font-medium text-[#9ca3af] mb-2\">数据库用户</label>\n              <UInput\n                v-model=\"botConfig.dbUser\"\n                placeholder=\"请输入数据库用户名\"\n                class=\"bg-[#0c0c0d]\"\n                @input=\"handleConfigChange\"\n              />\n            </div>\n            \n            <div class=\"md:col-span-2\">\n              <label class=\"block text-sm font-medium text-[#9ca3af] mb-2\">数据库密码</label>\n              <UInput\n                v-model=\"botConfig.dbPassword\"\n                type=\"password\"\n                placeholder=\"请输入数据库密码\"\n                class=\"bg-[#0c0c0d]\"\n                @input=\"handleConfigChange\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <!-- Tron API 配置 -->\n        <div>\n          <h4 class=\"text-md font-medium text-white mb-3 flex items-center\">\n            <UIcon name=\"i-heroicons-key\" class=\"w-4 h-4 mr-2\" />\n            Tron API 配置\n          </h4>\n          <div class=\"grid grid-cols-1 gap-4\">\n            <div>\n              <label class=\"block text-sm font-medium text-[#9ca3af] mb-2\">\n                Tron API Key\n                <span class=\"text-xs text-[#6b7280] ml-2\">(来自 hy.py 文件)</span>\n              </label>\n              <UInput\n                v-model=\"botConfig.tronApiKey\"\n                placeholder=\"请输入 Tron API Key\"\n                class=\"bg-[#0c0c0d]\"\n                @input=\"handleConfigChange\"\n              />\n              <p class=\"mt-1 text-xs text-[#6b7280]\">\n                修改后将自动保存到 hy.py 文件中的 tron_api_key 变量\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n\n\n\n\n\n  </div>\n</template>\n\n<script setup>\n// 页面元数据\ndefinePageMeta({\n  title: '机器人管理',\n  description: '管理和配置 Telegram 机器人',\n  middleware: 'auth'\n})\n\n// 响应式数据\nconst botConfig = ref({\n  // 基础配置 (来自 config.txt)\n  token: '',\n  controlAddress: '',\n  adminId: '',\n  customerServiceId: '',\n  tiaozhuan: '',\n  \n  // 价格配置 (来自 config.txt)\n  threePrice: '',\n  sixPrice: '',\n  yearPrice: '',\n  \n  // 资源配置 (来自 .env)\n  resHash: '',\n  resCookie: '',\n  walletMnemonic: '',\n  \n  // 数据库配置 (来自 .env)\n  dbHost: '',\n  dbUser: '',\n  dbPassword: '',\n  dbName: '',\n  dbPort: '',\n  \n  // Tron API 配置 (来自 hy.py)\n  tronApiKey: ''\n})\n\n// 保存状态\nconst isSaving = ref(false)\nconst lastSaved = ref(false)\nlet saveTimeout = null\n\n// 重启状态\nconst isRestarting = ref(false)\nconst showRestartProgress = ref(false)\nconst restartProgress = ref(0)\nconst restartStatus = ref('')\n\n// 热更新状态\nconst hotReloadEnabled = ref(false)\n\n// 方法\nconst maskToken = (token) => {\n  if (!token) return ''\n  return token.substring(0, 10) + '...' + token.substring(token.length - 10)\n}\n\nconst handleConfigChange = () => {\n  // 清除之前的定时器\n  if (saveTimeout) {\n    clearTimeout(saveTimeout)\n  }\n  \n  // 重置保存状态\n  lastSaved.value = false\n  \n  // 设置3秒后自动保存\n  saveTimeout = setTimeout(() => {\n    saveConfig()\n  }, 3000)\n}\n\nconst handleHotReloadToggle = () => {\n  console.log('热更新状态切换:', hotReloadEnabled.value)\n  // 当热更新开启时，自动保存配置\n  if (hotReloadEnabled.value) {\n    saveConfig()\n  }\n}\n\nconst saveConfig = async () => {\n  try {\n    isSaving.value = true\n    \n    console.log('保存配置:', botConfig.value)\n    \n    // 调用API保存配置到文件\n    const response = await $fetch('/api/bot-config', {\n      method: 'POST',\n      body: {\n        ...botConfig.value,\n        hotReload: hotReloadEnabled.value\n      }\n    })\n    \n    if (response.success) {\n      console.log('配置保存成功')\n      \n      // 显示保存成功状态\n      lastSaved.value = true\n      \n      // 根据热更新状态显示不同的提示\n      if (hotReloadEnabled.value) {\n        // 显示热更新成功提示\n        const toast = useToast()\n        toast.add({\n          title: '配置已保存并热更新',\n          description: '机器人配置已自动重载，无需重启',\n          icon: 'i-heroicons-bolt',\n          color: 'green'\n        })\n      }\n      \n      // 3秒后隐藏保存成功状态\n      setTimeout(() => {\n        lastSaved.value = false\n      }, 3000)\n    } else {\n      console.error('保存配置失败:', response.error)\n      const toast = useToast()\n      toast.add({\n        title: '保存失败',\n        description: response.error || '配置保存失败，请重试',\n        icon: 'i-heroicons-exclamation-triangle',\n        color: 'red'\n      })\n    }\n    \n  } catch (error) {\n    console.error('保存配置失败:', error)\n    const toast = useToast()\n    toast.add({\n      title: '保存失败',\n      description: '网络错误，请检查连接后重试',\n      icon: 'i-heroicons-exclamation-triangle',\n      color: 'red'\n    })\n  } finally {\n    isSaving.value = false\n  }\n}\n\nconst restartBot = async () => {\n  try {\n    isRestarting.value = true\n    showRestartProgress.value = true\n    restartProgress.value = 0\n    restartStatus.value = '正在检查机器人进程...'\n    \n    // 模拟进度更新\n    const updateProgress = (progress, status) => {\n      restartProgress.value = progress\n      restartStatus.value = status\n    }\n    \n    // 调用重启API\n    const response = await $fetch('/api/restart-bot', {\n      method: 'POST'\n    })\n    \n    if (response.success) {\n      // 模拟重启进度\n      updateProgress(20, '正在停止现有进程...')\n      await new Promise(resolve => setTimeout(resolve, 1000))\n      \n      updateProgress(50, '正在清理资源...')\n      await new Promise(resolve => setTimeout(resolve, 1000))\n      \n      updateProgress(80, '正在启动机器人...')\n      await new Promise(resolve => setTimeout(resolve, 1500))\n      \n      updateProgress(100, '重启完成')\n      \n      // 2秒后隐藏进度条\n      setTimeout(() => {\n        showRestartProgress.value = false\n        restartProgress.value = 0\n        restartStatus.value = ''\n      }, 2000)\n      \n      console.log('机器人重启成功')\n    } else {\n      console.error('重启机器人失败:', response.error)\n      restartStatus.value = '重启失败: ' + response.error\n    }\n    \n  } catch (error) {\n    console.error('重启机器人失败:', error)\n    restartStatus.value = '重启失败: ' + error.message\n  } finally {\n    isRestarting.value = false\n  }\n}\n\n// 页面加载时读取配置\nonMounted(async () => {\n  try {\n    console.log('加载配置...')\n    \n    // 调用API读取配置文件\n    const response = await $fetch('/api/bot-config')\n    \n    if (response.success && response.data) {\n      // 更新配置数据\n      botConfig.value = { ...response.data }\n      console.log('配置加载成功:', botConfig.value)\n    } else {\n      console.error('加载配置失败:', response.error)\n    }\n    \n  } catch (error) {\n    console.error('加载配置失败:', error)\n  }\n})\n\n// 页面卸载时清理定时器\nonUnmounted(() => {\n  if (saveTimeout) {\n    clearTimeout(saveTimeout)\n  }\n})\n</script>"],"version":3}