# 数据库配置
DB_HOST=43.134.176.136
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# JWT 密钥（用于生成访问令牌）
JWT_SECRET=your_jwt_secret_key_here

# WordPress 配置（子比主题）
# WordPress 站点 URL
WORDPRESS_URL=https://hfz.pw

# WordPress 用户名
WORDPRESS_USERNAME=your_wordpress_username

# 认证方式1：Application Password（推荐）
# 在 WordPress 后台「用户」→「个人资料」→「应用程序密码」生成
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# 认证方式2：JWT Token（可选）
# 需要安装 JWT Authentication 插件
WORDPRESS_JWT_TOKEN=your_jwt_token_here

# 商品 ID（https://hfz.pw/shop/2101.html）
WORDPRESS_PRODUCT_ID=2101

# WordPress 数据库直连（备选方案）
# 如果 REST API 不可用，可以直接连接 WordPress 数据库
# WP_DB_HOST=your_wp_db_host
# WP_DB_PORT=3306
# WP_DB_USER=your_wp_db_user
# WP_DB_PASSWORD=your_wp_db_password
# WP_DB_NAME=your_wp_db_name

# 开发环境配置
NUXT_HOST=0.0.0.0
NUXT_PORT=3000
