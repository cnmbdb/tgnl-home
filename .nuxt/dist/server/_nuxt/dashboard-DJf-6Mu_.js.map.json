{"file":"dashboard-DJf-6Mu_.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA8TA,UAAM,eAAe,IAAI;AAAA,MACvB,QAAQ;AAAA,MACR,aAAa;AAAA,MACb,mBAAmB;AAAA,MACnB,mBAAmB;AAAA,IAAA,CACpB;AAED,UAAM,kBAAkB,IAAI;AAAA,MAC1B,QAAQ;AAAA,MACR,aAAa;AAAA,MACb,oBAAoB;AAAA,MACpB,YAAY;AAAA,IAAA,CACb;AAUD,UAAM,aAAa,IAAI;AAAA,MACrB,QAAQ;AAAA,MACR,eAAe;AAAA,MACf,QAAQ;AAAA,MACR,cAAc;AAAA,IAAA,CACf;AAUD,UAAM,WAAW,IAAI;AAAA,MACnB,QAAQ;AAAA,MACR,YAAY;AAAA,MACZ,eAAe;AAAA,MACf,QAAQ;AAAA,MACR,aAAa;AAAA,IAAA,CACd;AAWD,UAAM,eAAe,IAAI,EAAE;AAC3B,UAAM,eAAe,IAAI,CAAC;AAE1B,UAAM,mBAAmB,IAAI;AAAA,MAC3B;AAAA,QACE,IAAI;AAAA,QACJ,MAAM;AAAA,QACN,SAAS;AAAA,QACT,MAAM;AAAA,QACN,MAAM;AAAA,QACN,QAAQ;AAAA,MAAA;AAAA,MAEV;AAAA,QACE,IAAI;AAAA,QACJ,MAAM;AAAA,QACN,SAAS;AAAA,QACT,MAAM;AAAA,QACN,MAAM;AAAA,QACN,QAAQ;AAAA,MAAA;AAAA,MAEV;AAAA,QACE,IAAI;AAAA,QACJ,MAAM;AAAA,QACN,SAAS;AAAA,QACT,MAAM;AAAA,QACN,MAAM;AAAA,QACN,QAAQ;AAAA,MAAA;AAAA,MAEV;AAAA,QACE,IAAI;AAAA,QACJ,MAAM;AAAA,QACN,SAAS;AAAA,QACT,MAAM;AAAA,QACN,MAAM;AAAA,QACN,QAAQ;AAAA,MAAA;AAAA,IACV,CACD;AAkCD,UAAM,iBAAiB,YAAY;AACjC,UAAI;AACF,cAAM,WAAW,MAAM,OAAO,iBAAiB;AAC/C,YAAI,SAAS,SAAS;AACpB,uBAAa,QAAQ,SAAS,KAAK;AACnC,uBAAa,QAAQ,SAAS,KAAK,gBAAgB,SAAS,KAAK,UAAU;AAAA,QAC7E;AAAA,MACF,SAAS,OAAO;AACd,gBAAQ,MAAM,cAAc,KAAK;AACjC,qBAAa,QAAQ,CAAA;AACrB,qBAAa,QAAQ;AAAA,MACvB;AAAA,IACF;AAGA,UAAM,mBAAmB,YAAY;AACnC,YAAM,eAAA;AAAA,IACR;AAGA,UAAM,iBAAiB,CAAC,eAAe;AACrC,YAAM,OAAO,IAAI,KAAK,UAAU;AAChC,aAAO,KAAK,eAAe,SAAS;AAAA,QAClC,MAAM;AAAA,QACN,OAAO;AAAA,QACP,KAAK;AAAA,QACL,MAAM;AAAA,QACN,QAAQ;AAAA,QACR,QAAQ;AAAA,MAAA,CACT;AAAA,IACH;AAGA,UAAM,eAAe,CAAC,WAAW;AAC/B,UAAI,UAAU,KAAW;AACvB,gBAAQ,SAAS,KAAW,QAAQ,CAAC,IAAI;AAAA,MAC3C,WAAW,UAAU,KAAO;AAC1B,gBAAQ,SAAS,KAAO,QAAQ,CAAC,IAAI;AAAA,MACvC,OAAO;AACL,eAAO,OAAO,SAAA;AAAA,MAChB;AAAA,IACF;;;;;AAleO,YAAA,OAAAA,eAAAC,WAAA,EAAA,OAAM,eAAW,MAAA,CAAA,CAAA,+NAAA;;QAML,MAAK;AAAA,QAAmB,OAAM;AAAA,MAAA;;;QAOhC,SAAQ;AAAA,QAAU,MAAK;AAAA,MAAA;yBAAhC,CAGU,GAAAC,QAAAC,UAAA,aAAA;;;cAFD,MAAK;AAAA,cAAyB,OAAM;AAAA,YAAA;;;;cAA3CC,YAA4D,kBAAA;AAAA,gBAArD,MAAK;AAAA,gBAAyB,OAAM;AAAA,cAAA;8BAAiB,QAE9D;AAAA,YAAA;AAAA;;;;;QACS,OAAM;AAAA,QAAU,MAAK;AAAA,QAAK,OAAM;AAAA,MAAA;yBAAzC,CAGU,GAAAF,QAAAC,UAAA,aAAA;;;cAFD,MAAK;AAAA,cAA0B,OAAM;AAAA,YAAA;;;;cAA5CC,YAA6D,kBAAA;AAAA,gBAAtD,MAAK;AAAA,gBAA0B,OAAM;AAAA,cAAA;8BAAiB,QAE/D;AAAA,YAAA;AAAA;;;;;;QASW,MAAK;AAAA,QAAmB,OAAM;AAAA,MAAA;AAIc,YAAA,sHAAAC,eAAAC,MAAA,YAAA,EAAa,MAAM,CAAA,0MAAA;;QAQ/D,MAAK;AAAA,QAAoB,OAAM;AAAA,MAAA;AAIS,YAAA,iHAAAD,eAAAC,MAAA,YAAA,EAAa,WAAW,CAAA,4MAAA;;QAQhE,MAAK;AAAA,QAA8B,OAAM;AAAA,MAAA;AAID,YAAA,iHAAAD,eAAAC,MAAA,YAAA,EAAa,iBAAiB,CAAA,4MAAA;;QAQtE,MAAK;AAAA,QAAmB,OAAM;AAAA,MAAA;6IAIU,aAAaA,MAAA,YAAA,EAAa,iBAAiB,CAAA,CAAA,oSAAA;;QAYnF,MAAK;AAAA,QAA0B,OAAM;AAAA,MAAA;;;QAGrC,OAAOA,MAAA,eAAA,EAAgB,WAAM,WAAA,UAAA;AAAA,QAAiC,SAAQ;AAAA,MAAA;yBAA/E,CAES,GAAAJ,QAAAC,UAAA,aAAA;;AADJD,mBAAA,GAAAG,eAAAC,MAAA,eAAA,EAAgB,WAAM,WAAA,OAAA,IAAA,CAAA,EAAA;AAAA;;cAAtBC,gBAAAC,gBAAAF,MAAA,eAAA,EAAgB,WAAM,WAAA,OAAA,IAAA,GAAA,CAAA;AAAA,YAAA;AAAA;;;;0MAOqBD,eAAAC,MAAA,eAAA,EAAgB,WAAW,8KAI3BD,eAAAC,MAAA,eAAA,EAAgB,kBAAkB;;QASrE,MAAK;AAAA,QAAuB,OAAM;AAAA,MAAA;;AAE3B,UAAAA,MAAA,YAAA,MAAiB,QAAS;;UAAG,OAAOA,MAAA,YAAA,IAAY,IAAA,UAAA;AAAA,UAAwB,SAAQ;AAAA,UAAS,MAAK;AAAA,QAAA;2BAA5G,CAES,GAAAJ,QAAAC,UAAA,aAAA;;uCADJG,MAAA,YAAA,CAAY,CAAA,OAAA;AAAA;;gBAAZC,gBAAAC,gBAAAF,MAAA,YAAA,CAAY,IAAG,SACpB,CAAA;AAAA,cAAA;AAAA;;;;;;;;;QAEO,SAAQ;AAAA,QAAQ,MAAK;AAAA,QAAM,SAAO;AAAA,MAAA;yBAA3C,CAEU,GAAAJ,QAAAC,UAAA,aAAA;;;cADD,MAAK;AAAA,cAAyB,OAAM;AAAA,YAAA;;;cAA3CC,YAAuD,kBAAA;AAAA,gBAAhD,MAAK;AAAA,gBAAyB,OAAM;AAAA,cAAA;;;;;;;AAIpC,UAAAE,MAAA,YAAA,EAAa,SAAM,GAAA;;AACLG,sBAAAH,MAAA,YAAA,IAAX,YAAO;AAImC,gBAAA,mQAAAD,eAAA,QAAQ,IAAI,CAAA,eAAA;;YAEtD,OAAM;AAAA,YAAQ,SAAQ;AAAA,YAAS,MAAK;AAAA,UAAA;6BAA5C,CAA6D,GAAAH,QAAAC,UAAA,aAAA;;;;;kCAAZ,KAAG;AAAA,gBAAA;AAAA;;;;iJAMjBE,eAAA,QAAQ,GAAG,6FAIXA,eAAA,QAAQ,MAAM,4FAIdA,eAAA,QAAQ,QAAQ,4FAIhBA,eAAA,QAAQ,QAAQ,wIAMlB,eAAe,QAAQ,SAAS,CAAA;;;;;;UAM9D,MAAK;AAAA,UAAmC,OAAM;AAAA,QAAA;;;AAaT,YAAA,kbAAAA,eAAAC,MAAA,eAAA,EAAgB,UAAU,CAAA,8OAAA;;QASjE,MAAK;AAAA,QAAqB,OAAM;AAAA,MAAA;;;QAGhC,OAAOA,MAAA,UAAA,EAAW,WAAM,WAAA,UAAA;AAAA,QAAiC,SAAQ;AAAA,MAAA;yBAA1E,CAES,GAAAJ,QAAAC,UAAA,aAAA;;AADJD,mBAAA,GAAAG,eAAAC,MAAA,UAAA,EAAW,WAAM,WAAA,OAAA,IAAA,CAAA,EAAA;AAAA;;cAAjBC,gBAAAC,gBAAAF,MAAA,UAAA,EAAW,WAAM,WAAA,OAAA,IAAA,GAAA,CAAA;AAAA,YAAA;AAAA;;;;0MAO0BD,eAAAC,MAAA,UAAA,EAAW,aAAa,8KAIxBD,eAAAC,MAAA,UAAA,EAAW,MAAM,4XAYjBD,eAAAC,MAAA,UAAA,EAAW,YAAY;;QAUhE,MAAK;AAAA,QAA2B,OAAM;AAAA,MAAA;;;QAGtC,OAAOA,MAAA,QAAA,EAAS,WAAM,cAAA,UAAA;AAAA,QAAoC,SAAQ;AAAA,MAAA;yBAA3E,CAES,GAAAJ,QAAAC,UAAA,aAAA;;AADJD,mBAAA,GAAAG,eAAAC,MAAA,QAAA,EAAS,WAAM,cAAA,QAAA,MAAA,CAAA,EAAA;AAAA;;cAAfC,gBAAAC,gBAAAF,MAAA,QAAA,EAAS,WAAM,cAAA,QAAA,MAAA,GAAA,CAAA;AAAA,YAAA;AAAA;;;;6NAO2BD,eAAAC,MAAA,QAAA,EAAS,UAAU,6KAInBD,eAAAC,MAAA,QAAA,EAAS,aAAa,6KAItBD,eAAAC,MAAA,QAAA,EAAS,MAAM,8KAIfD,eAAAC,MAAA,QAAA,EAAS,WAAW;;QAkBpD,MAAK;AAAA,QAAyB,OAAM;AAAA,MAAA;;;QAUpC,MAAK;AAAA,QAA4B,OAAM;AAAA,MAAA;;;QAUvC,MAAK;AAAA,QAA0B,OAAM;AAAA,MAAA;;AAkB1BG,oBAAAH,MAAA,gBAAA,IAAZ,aAAQ;;;UAER,MAAM,SAAS;AAAA,UAAM,OAAM;AAAA,QAAA;yEAGFD,eAAA,SAAS,OAAO,0CACZA,eAAA,SAAS,IAAI;;UAE3C,OAAO,SAAS,SAAI,YAAA,UAA2B,SAAS,SAAI,YAAA,WAAA;AAAA,UAAmC,SAAQ;AAAA,UAAS,MAAK;AAAA,QAAA;2BAA9H,CAES,GAAAH,QAAAC,UAAA,aAAA;;AADJD,qBAAA,GAAAG,eAAA,SAAS,MAAM,CAAA,EAAA;AAAA;;gBAAfE,gBAAAC,gBAAA,SAAS,MAAM,GAAA,CAAA;AAAA,cAAA;AAAA;;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_push","_parent","_createVNode","_ssrInterpolate","_unref","_createTextVNode","_toDisplayString","_ssrRenderList"],"sources":["../../../../pages/dashboard.vue"],"sourcesContent":["<template>\n  <div class=\"space-y-6\">\n    <!-- 页面标题 -->\n    <div class=\"flex items-center justify-between\">\n      <div>\n        <h1 class=\"text-2xl font-bold text-white flex items-center gap-3\">\n          <div class=\"w-8 h-8 bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg flex items-center justify-center\">\n            <UIcon name=\"i-heroicons-bolt\" class=\"w-5 h-5 text-[#00dc82]\" />\n          </div>\n          能量出租管理系统\n        </h1>\n        <p class=\"mt-1 text-sm text-[#9ca3af]\">监控能量出租机器人状态和交易数据</p>\n      </div>\n      <div class=\"flex gap-2\">\n        <UButton variant=\"outline\" size=\"sm\">\n          <UIcon name=\"i-heroicons-arrow-path\" class=\"w-4 h-4 mr-2\" />\n          刷新数据\n        </UButton>\n        <UButton color=\"primary\" size=\"sm\" class=\"bg-[#00dc82] hover:bg-[#00dc82]/80\">\n          <UIcon name=\"i-heroicons-cog-6-tooth\" class=\"w-4 h-4 mr-2\" />\n          系统设置\n        </UButton>\n      </div>\n    </div>\n\n    <!-- 系统状态概览 -->\n    <div class=\"grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4\">\n      <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg p-4\">\n        <div class=\"flex items-center\">\n          <div class=\"w-10 h-10 bg-green-500/10 rounded-lg flex items-center justify-center\">\n            <UIcon name=\"i-heroicons-bolt\" class=\"w-5 h-5 text-green-400\" />\n          </div>\n          <div class=\"ml-3\">\n            <p class=\"text-sm text-[#9ca3af]\">机器人状态</p>\n            <p class=\"text-xl font-semibold text-green-400\">{{ systemStatus.status }}</p>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg p-4\">\n        <div class=\"flex items-center\">\n          <div class=\"w-10 h-10 bg-blue-500/10 rounded-lg flex items-center justify-center\">\n            <UIcon name=\"i-heroicons-users\" class=\"w-5 h-5 text-blue-400\" />\n          </div>\n          <div class=\"ml-3\">\n            <p class=\"text-sm text-[#9ca3af]\">活跃用户</p>\n            <p class=\"text-xl font-semibold text-white\">{{ systemStatus.activeUsers }}</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg p-4\">\n        <div class=\"flex items-center\">\n          <div class=\"w-10 h-10 bg-purple-500/10 rounded-lg flex items-center justify-center\">\n            <UIcon name=\"i-heroicons-currency-dollar\" class=\"w-5 h-5 text-purple-400\" />\n          </div>\n          <div class=\"ml-3\">\n            <p class=\"text-sm text-[#9ca3af]\">今日交易</p>\n            <p class=\"text-xl font-semibold text-white\">{{ systemStatus.todayTransactions }}</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg p-4\">\n        <div class=\"flex items-center\">\n          <div class=\"w-10 h-10 bg-yellow-500/10 rounded-lg flex items-center justify-center\">\n            <UIcon name=\"i-heroicons-bolt\" class=\"w-5 h-5 text-yellow-400\" />\n          </div>\n          <div class=\"ml-3\">\n            <p class=\"text-sm text-[#9ca3af]\">总能量出租</p>\n            <p class=\"text-xl font-semibold text-white\">{{ formatEnergy(systemStatus.totalEnergyRented) }}</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 服务状态监控 -->\n    <div class=\"grid grid-cols-1 gap-6 lg:grid-cols-2\">\n      <!-- Telegram 机器人服务 -->\n      <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg\">\n        <div class=\"px-4 py-3 border-b border-[#2a2a2b] flex items-center justify-between\">\n          <h3 class=\"text-lg font-medium text-white flex items-center gap-2\">\n            <UIcon name=\"i-simple-icons-telegram\" class=\"w-5 h-5 text-blue-400\" />\n            能量出租机器人\n          </h3>\n          <UBadge :color=\"telegramService.status === 'online' ? 'green' : 'red'\" variant=\"subtle\">\n            {{ telegramService.status === 'online' ? '在线' : '离线' }}\n          </UBadge>\n        </div>\n        \n        <div class=\"p-4 space-y-4\">\n          <div class=\"grid grid-cols-2 gap-4\">\n            <div class=\"bg-[#0c0c0d] border border-[#2a2a2b] rounded-md p-3 text-center\">\n              <p class=\"text-2xl font-bold text-white\">{{ telegramService.activeUsers }}</p>\n              <p class=\"text-xs text-[#9ca3af]\">活跃用户</p>\n            </div>\n            <div class=\"bg-[#0c0c0d] border border-[#2a2a2b] rounded-md p-3 text-center\">\n              <p class=\"text-2xl font-bold text-white\">{{ telegramService.energyTransactions }}</p>\n              <p class=\"text-xs text-[#9ca3af]\">能量交易</p>\n            </div>\n          </div>\n          \n          <!-- 机器人进程状态 -->\n          <div class=\"bg-[#0c0c0d] border border-[#2a2a2b] rounded-md p-4\">\n            <div class=\"flex items-center justify-between mb-3\">\n              <h4 class=\"text-sm font-medium text-white flex items-center gap-2\">\n                <UIcon name=\"i-heroicons-cpu-chip\" class=\"w-4 h-4 text-blue-400\" />\n                机器人进程状态\n                <UBadge v-if=\"processCount !== undefined\" :color=\"processCount > 0 ? 'green' : 'red'\" variant=\"subtle\" size=\"xs\">\n                  {{ processCount }} 个进程\n                </UBadge>\n              </h4>\n              <UButton variant=\"ghost\" size=\"xs\" @click=\"refreshBotStatus\">\n                <UIcon name=\"i-heroicons-arrow-path\" class=\"w-3 h-3\" />\n              </UButton>\n            </div>\n            \n            <div v-if=\"botProcesses.length > 0\" class=\"space-y-3\">\n              <div v-for=\"process in botProcesses\" :key=\"process.pid\" class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-md p-3\">\n                <div class=\"flex items-center justify-between mb-2\">\n                  <div class=\"flex items-center space-x-2\">\n                    <div class=\"w-2 h-2 bg-green-400 rounded-full\"></div>\n                    <span class=\"text-sm font-medium text-white\">{{ process.name }}</span>\n                  </div>\n                  <UBadge color=\"green\" variant=\"subtle\" size=\"xs\">运行中</UBadge>\n                </div>\n                \n                <div class=\"grid grid-cols-2 gap-3 text-xs\">\n                  <div>\n                    <span class=\"text-[#9ca3af]\">进程ID:</span>\n                    <span class=\"text-white ml-1\">{{ process.pid }}</span>\n                  </div>\n                  <div>\n                    <span class=\"text-[#9ca3af]\">运行时间:</span>\n                    <span class=\"text-white ml-1\">{{ process.uptime }}</span>\n                  </div>\n                  <div>\n                    <span class=\"text-[#9ca3af]\">CPU:</span>\n                    <span class=\"text-white ml-1\">{{ process.cpuUsage }}%</span>\n                  </div>\n                  <div>\n                    <span class=\"text-[#9ca3af]\">内存:</span>\n                    <span class=\"text-white ml-1\">{{ process.memUsage }}%</span>\n                  </div>\n                </div>\n                \n                <div class=\"mt-2 text-xs\">\n                  <span class=\"text-[#9ca3af]\">启动时间:</span>\n                  <span class=\"text-white ml-1\">{{ formatDateTime(process.startedAt) }}</span>\n                </div>\n              </div>\n            </div>\n            \n            <div v-else class=\"text-center py-4\">\n              <UIcon name=\"i-heroicons-exclamation-triangle\" class=\"w-8 h-8 text-yellow-400 mx-auto mb-2\" />\n              <p class=\"text-sm text-[#9ca3af]\">未检测到机器人进程</p>\n            </div>\n          </div>\n          \n          <div class=\"flex items-center justify-between p-3 bg-[#0c0c0d] border border-[#2a2a2b] rounded-md\">\n            <div class=\"flex items-center space-x-3\">\n              <div class=\"relative\">\n                <div class=\"w-3 h-3 bg-green-400 rounded-full animate-pulse\"></div>\n                <div class=\"absolute inset-0 w-3 h-3 bg-green-400 rounded-full animate-ping opacity-75\"></div>\n              </div>\n              <span class=\"text-white font-medium\">已连接</span>\n            </div>\n            <span class=\"text-sm text-[#9ca3af]\">最后更新: {{ telegramService.lastUpdate }}</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- API 服务状态 -->\n      <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg\">\n        <div class=\"px-4 py-3 border-b border-[#2a2a2b] flex items-center justify-between\">\n          <h3 class=\"text-lg font-medium text-white flex items-center gap-2\">\n            <UIcon name=\"i-heroicons-server\" class=\"w-5 h-5 text-green-400\" />\n            API 服务\n          </h3>\n          <UBadge :color=\"apiService.status === 'normal' ? 'green' : 'red'\" variant=\"subtle\">\n            {{ apiService.status === 'normal' ? '正常' : '异常' }}\n          </UBadge>\n        </div>\n        \n        <div class=\"p-4 space-y-4\">\n          <div class=\"grid grid-cols-2 gap-4\">\n            <div class=\"bg-[#0c0c0d] border border-[#2a2a2b] rounded-md p-3 text-center\">\n              <p class=\"text-2xl font-bold text-white\">{{ apiService.requestsCount }}</p>\n              <p class=\"text-xs text-[#9ca3af]\">今日请求</p>\n            </div>\n            <div class=\"bg-[#0c0c0d] border border-[#2a2a2b] rounded-md p-3 text-center\">\n              <p class=\"text-2xl font-bold text-white\">{{ apiService.uptime }}%</p>\n              <p class=\"text-xs text-[#9ca3af]\">可用性</p>\n            </div>\n          </div>\n          \n          <div class=\"flex items-center justify-between p-3 bg-[#0c0c0d] border border-[#2a2a2b] rounded-md\">\n            <div class=\"flex items-center space-x-3\">\n              <div class=\"relative\">\n                <div class=\"w-3 h-3 bg-green-400 rounded-full\"></div>\n              </div>\n              <span class=\"text-white font-medium\">服务正常</span>\n            </div>\n            <span class=\"text-sm text-[#9ca3af]\">响应时间: {{ apiService.responseTime }}ms</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 数据库状态 -->\n    <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg\">\n      <div class=\"px-4 py-3 border-b border-[#2a2a2b] flex items-center justify-between\">\n        <h3 class=\"text-lg font-medium text-white flex items-center gap-2\">\n          <UIcon name=\"i-heroicons-circle-stack\" class=\"w-5 h-5 text-blue-400\" />\n          数据库状态\n        </h3>\n        <UBadge :color=\"database.status === 'connected' ? 'green' : 'red'\" variant=\"subtle\">\n          {{ database.status === 'connected' ? '已连接' : '连接失败' }}\n        </UBadge>\n      </div>\n      \n      <div class=\"p-4\">\n        <div class=\"grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4\">\n          <div class=\"bg-[#0c0c0d] border border-[#2a2a2b] rounded-md p-3 text-center\">\n            <p class=\"text-lg font-bold text-white\">{{ database.totalUsers }}</p>\n            <p class=\"text-xs text-[#9ca3af]\">总用户数</p>\n          </div>\n          <div class=\"bg-[#0c0c0d] border border-[#2a2a2b] rounded-md p-3 text-center\">\n            <p class=\"text-lg font-bold text-white\">{{ database.totalMessages }}</p>\n            <p class=\"text-xs text-[#9ca3af]\">总消息数</p>\n          </div>\n          <div class=\"bg-[#0c0c0d] border border-[#2a2a2b] rounded-md p-3 text-center\">\n            <p class=\"text-lg font-bold text-white\">{{ database.dbSize }}</p>\n            <p class=\"text-xs text-[#9ca3af]\">数据库大小</p>\n          </div>\n          <div class=\"bg-[#0c0c0d] border border-[#2a2a2b] rounded-md p-3 text-center\">\n            <p class=\"text-lg font-bold text-white\">{{ database.connections }}</p>\n            <p class=\"text-xs text-[#9ca3af]\">活跃连接</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 快速操作 -->\n    <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg\">\n      <div class=\"px-4 py-3 border-b border-[#2a2a2b]\">\n        <h3 class=\"text-lg font-medium text-white\">快速操作</h3>\n      </div>\n      \n      <div class=\"p-4\">\n        <div class=\"grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n          <div class=\"bg-[#0c0c0d] border border-[#2a2a2b] rounded-md p-4 hover:bg-[#2a2a2b]/50 transition-colors cursor-pointer\">\n            <div class=\"text-center\">\n              <div class=\"w-12 h-12 bg-blue-500/10 rounded-lg flex items-center justify-center mx-auto mb-3\">\n                <UIcon name=\"i-heroicons-arrow-path\" class=\"w-6 h-6 text-blue-400\" />\n              </div>\n              <h4 class=\"text-sm font-medium text-white mb-1\">刷新状态</h4>\n              <p class=\"text-xs text-[#9ca3af]\">更新所有服务状态</p>\n            </div>\n          </div>\n          \n          <div class=\"bg-[#0c0c0d] border border-[#2a2a2b] rounded-md p-4 hover:bg-[#2a2a2b]/50 transition-colors cursor-pointer\">\n            <div class=\"text-center\">\n              <div class=\"w-12 h-12 bg-green-500/10 rounded-lg flex items-center justify-center mx-auto mb-3\">\n                <UIcon name=\"i-heroicons-document-text\" class=\"w-6 h-6 text-green-400\" />\n              </div>\n              <h4 class=\"text-sm font-medium text-white mb-1\">查看日志</h4>\n              <p class=\"text-xs text-[#9ca3af]\">系统运行日志</p>\n            </div>\n          </div>\n          \n          <div class=\"bg-[#0c0c0d] border border-[#2a2a2b] rounded-md p-4 hover:bg-[#2a2a2b]/50 transition-colors cursor-pointer\">\n            <div class=\"text-center\">\n              <div class=\"w-12 h-12 bg-purple-500/10 rounded-lg flex items-center justify-center mx-auto mb-3\">\n                <UIcon name=\"i-heroicons-cog-6-tooth\" class=\"w-6 h-6 text-purple-400\" />\n              </div>\n              <h4 class=\"text-sm font-medium text-white mb-1\">系统设置</h4>\n              <p class=\"text-xs text-[#9ca3af]\">配置系统参数</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 最近活动 -->\n    <div class=\"bg-[#1a1a1b] border border-[#2a2a2b] rounded-lg\">\n      <div class=\"px-4 py-3 border-b border-[#2a2a2b]\">\n        <h3 class=\"text-lg font-medium text-white\">最近活动</h3>\n      </div>\n      \n      <div class=\"p-4\">\n        <div class=\"space-y-3\">\n          <div v-for=\"activity in recentActivities\" :key=\"activity.id\" class=\"flex items-center space-x-3 p-3 bg-[#0c0c0d] border border-[#2a2a2b] rounded-md\">\n            <div class=\"w-8 h-8 bg-blue-500/10 rounded-lg flex items-center justify-center\">\n              <UIcon :name=\"activity.icon\" class=\"w-4 h-4 text-blue-400\" />\n            </div>\n            <div class=\"flex-1\">\n              <p class=\"text-sm text-white\">{{ activity.message }}</p>\n              <p class=\"text-xs text-[#9ca3af]\">{{ activity.time }}</p>\n            </div>\n            <UBadge :color=\"activity.type === 'success' ? 'green' : activity.type === 'warning' ? 'yellow' : 'red'\" variant=\"subtle\" size=\"sm\">\n              {{ activity.status }}\n            </UBadge>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\n// 页面元数据\ndefinePageMeta({\n  title: '能量出租管理系统',\n  description: '监控能量出租机器人状态和交易数据'\n})\n\n// 响应式数据\nconst systemStatus = ref({\n  status: '正常运行',\n  activeUsers: 1247,\n  todayTransactions: 156,\n  totalEnergyRented: 125000000\n})\n\nconst telegramService = ref({\n  status: 'online',\n  activeUsers: 1247,\n  energyTransactions: 156,\n  lastUpdate: '刚刚'\n})\n\n// 组件销毁时清理定时器\nonUnmounted(() => {\n  if (refreshTimer) {\n    clearInterval(refreshTimer)\n    refreshTimer = null\n  }\n})\n\nconst apiService = ref({\n  status: 'normal',\n  requestsCount: 12847,\n  uptime: 99.9,\n  responseTime: 45\n})\n\n// 组件销毁时清理定时器\nonUnmounted(() => {\n  if (refreshTimer) {\n    clearInterval(refreshTimer)\n    refreshTimer = null\n  }\n})\n\nconst database = ref({\n  status: 'connected',\n  totalUsers: 5432,\n  totalMessages: 98765,\n  dbSize: '2.3GB',\n  connections: 12\n})\n\n// 组件销毁时清理定时器\nonUnmounted(() => {\n  if (refreshTimer) {\n    clearInterval(refreshTimer)\n    refreshTimer = null\n  }\n})\n\n// 机器人进程状态\nconst botProcesses = ref([])\nconst processCount = ref(0)\n\nconst recentActivities = ref([\n  {\n    id: 1,\n    icon: 'i-heroicons-bolt',\n    message: '用户完成能量出租交易',\n    time: '2分钟前',\n    type: 'success',\n    status: '成功'\n  },\n  {\n    id: 2,\n    icon: 'i-heroicons-user-plus',\n    message: '新用户开始使用能量出租服务',\n    time: '5分钟前',\n    type: 'success',\n    status: '成功'\n  },\n  {\n    id: 3,\n    icon: 'i-heroicons-currency-dollar',\n    message: '大额能量交易完成',\n    time: '10分钟前',\n    type: 'success',\n    status: '完成'\n  },\n  {\n    id: 4,\n    icon: 'i-heroicons-arrow-path',\n    message: '机器人自动处理能量分配',\n    time: '15分钟前',\n    type: 'info',\n    status: '处理中'\n  }\n])\n\n// 定时器引用\nlet refreshTimer = null\n\n// 生命周期钩子\nonMounted(() => {\n  // 初始化数据\n  refreshData()\n  \n  // 设置定时刷新\n  refreshTimer = setInterval(refreshData, 30000) // 每30秒刷新一次\n})\n\n// 组件销毁时清理定时器\nonUnmounted(() => {\n  if (refreshTimer) {\n    clearInterval(refreshTimer)\n    refreshTimer = null\n  }\n})\n\n// 方法\nconst refreshData = async () => {\n  try {\n    // 这里可以调用API获取实时数据\n    console.log('刷新仪表板数据')\n    await fetchBotStatus()\n  } catch (error) {\n    console.error('刷新数据失败:', error)\n  }\n}\n\n// 获取机器人状态\nconst fetchBotStatus = async () => {\n  try {\n    const response = await $fetch('/api/bot-status')\n    if (response.success) {\n      botProcesses.value = response.data.processes\n      processCount.value = response.data.processCount || response.data.processes.length\n    }\n  } catch (error) {\n    console.error('获取机器人状态失败:', error)\n    botProcesses.value = []\n    processCount.value = 0\n  }\n}\n\n// 刷新机器人状态\nconst refreshBotStatus = async () => {\n  await fetchBotStatus()\n}\n\n// 格式化日期时间\nconst formatDateTime = (dateString) => {\n  const date = new Date(dateString)\n  return date.toLocaleString('zh-CN', {\n    year: 'numeric',\n    month: '2-digit',\n    day: '2-digit',\n    hour: '2-digit',\n    minute: '2-digit',\n    second: '2-digit'\n  })\n}\n\n// 格式化能量数值\nconst formatEnergy = (energy) => {\n  if (energy >= 100000000) {\n    return (energy / 100000000).toFixed(1) + '亿'\n  } else if (energy >= 10000) {\n    return (energy / 10000).toFixed(1) + '万'\n  } else {\n    return energy.toString()\n  }\n}\n</script>"],"version":3}